r"""Equalizers and coequalizers in the category of sets, with their universal maps.

For parallel maps $f, g : X \to Y$ of sets, the equalizer is the subset
$\{x \in X : f(x) = g(x)\}$ with its inclusion, and the coequalizer is $Y$
modulo the equivalence relation generated by $f(x) \sim g(x)$ with its
projection.  Both statements are the definitions of these limits in
$\mathbf{Set}$; the factorization claims are their universal properties.
"""

from dzack_research.preamble.all import *  # noqa: F401,F403


def test_the_equalizer_of_residue_mod_three_and_zero_on_zero_to_five_is_zero_and_three() -> None:
    r"""$\{n \in \{0, \dots, 5\} : n \bmod 3 = 0\} = \{0, 3\}$, and a point $* \mapsto 3$ factors through it."""
    source = Sets.Δ[5]
    target = Sets.Δ[2]
    residue = Sets().Mor(source, target)(lambda n: target(n % 3))
    zero = Sets().Mor(source, target)(lambda _n: target(0))
    construction = Sets().equalizer_construction(residue, zero)
    shape = construction.diagram().domain()
    inclusion = construction.structure_morphism(shape.source())
    point = Sets.Δ[0]
    three = Sets().Mor(point, source)(lambda _p: source(3))
    cone = construction.diagram().Cones().cone(
        point, lambda index: three if index is shape.source() else residue * three
    )
    factor = construction.factor(cone).apex_map()

    assert Sets().equalizer(residue, zero).cardinality() == cardinal(2)
    assert {inclusion(x) for x in construction.object()} == {source(0), source(3)}
    assert inclusion(factor(point(0))) == source(3)


def test_the_equalizer_of_two_maps_that_never_agree_is_empty() -> None:
    r"""$x \mapsto x$ and $x \mapsto x + 1$ from $\{0, 1\}$ to $\{0, \dots, 3\}$ agree nowhere."""
    source = Sets.Δ[1]
    target = Sets.Δ[3]
    identity_shift = Sets().Mor(source, target)(lambda x: target(x))
    successor = Sets().Mor(source, target)(lambda x: target(x + 1))

    assert Sets().equalizer(identity_shift, successor).cardinality() == cardinal(0)


def test_the_coequalizer_of_x_and_x_plus_one_glues_zero_one_two_and_leaves_three() -> None:
    r"""On $\{0, \dots, 3\}$, $0 \sim 1 \sim 2$ and $3$ is alone: two classes.

    A map $h$ constant on $\{0, 1, 2\}$ satisfies $h s = h t$, so it factors
    as $h = u \circ p$ through the projection $p$.
    """
    source = Sets.Δ[1]
    target = Sets.Δ[3]
    inclusion = Sets().Mor(source, target)(lambda x: target(x))
    successor = Sets().Mor(source, target)(lambda x: target(x + 1))
    construction = Sets().coequalizer_construction(inclusion, successor)
    shape = construction.diagram().domain()
    projection = construction.costructure_morphism(shape.target())
    two = Sets.Δ[1]
    separating = Sets().Mor(target, two)(lambda y: two(0) if y < 3 else two(1))
    cocone = construction.diagram().Cocones().cocone(
        two,
        lambda index: separating * inclusion if index is shape.source() else separating,
    )
    factor = construction.factor(cocone).apex_map()

    assert Sets().coequalizer(inclusion, successor).cardinality() == cardinal(2)
    assert projection(target(0)) == projection(target(2))
    assert projection(target(0)) != projection(target(3))
    assert all(factor(projection(y)) == separating(y) for y in target)


def test_finite_coequalizer_keeps_an_unenumerated_relation_source_symbolic() -> None:
    from dzack_research.preamble.logic import AtomicProposition

    ambient = Sets.Δ[2]
    source = Sets().condition_set(
        ambient, lambda x: AtomicProposition("undecided_subset_membership", x)
    )
    assert source in Sets().Finite()
    assert source not in EnumeratedSets()
    arrow = Sets().Mor(source, ambient)(lambda point: ambient(point))
    construction = Sets().coequalizer_construction(arrow, arrow)
    quotient = construction.object()
    shape = construction.diagram().domain()
    projection = construction.costructure_morphism(shape.target())
    assert quotient in FiniteSets()
    assert quotient not in EnumeratedSets()
    assert projection.domain() is ambient and projection.codomain() is quotient
    # The identical arrows generate no identifications beyond equality,
    # independently of the undecidable membership of their source.
    assert projection(ambient(0)) != projection(ambient(1))
    assert projection(ambient(0)) == projection(ambient(0))


def test_coequalizer_uses_the_targets_selected_ranking() -> None:
    from dzack_research.preamble.categories.sets.finite_ordered_sets import finite_ordered_set

    source = Sets.Δ[0]
    target = finite_ordered_set(("c", "a", "b"))
    first = Sets().Mor(source, target)(lambda _point: target("c"))
    second = Sets().Mor(source, target)(lambda _point: target("b"))
    quotient = Sets().coequalizer(first, second)
    assert quotient.cardinality() == cardinal(2)
    # The target order identifies the positions of c and b (0 and 2),
    # independently of lexicographic order or a reconstructed set.
    assert target.ranking_map()(target("c")) == 0
    assert target.ranking_map()(target("b")) == 2


def test_infinite_relation_source_has_an_actual_quotient_and_factor_map() -> None:
    r"""The relation n ~ n+2 on ZZ gives a quotient through which parity factors.

    The two supplied set functions do not carry an additive or affine
    presentation: this specimen verifies the represented quotient and
    universal map, not a computed claim that its cardinality equals two.
    """
    integers = ZZ
    identity = Sets().Mor(integers, integers).identity()
    translate = Sets().Mor(integers, integers)(
        lambda n: integers(n + integers(2))
    )
    construction = Sets().coequalizer_construction(identity, translate)
    quotient = construction.object()
    shape = construction.diagram().domain()
    projection = construction.costructure_morphism(shape.target())

    assert quotient in Sets()
    assert quotient.left_morphism() is identity
    assert quotient.right_morphism() is translate
    assert projection.domain() is integers and projection.codomain() is quotient
    assert projection(integers(0)).representative() == integers(0)

    parity_values = Sets.Δ[1]
    parity = Sets().Mor(integers, parity_values)(
        lambda n: parity_values(int(n) % 2)
    )
    cocone = construction.diagram().Cocones().cocone(
        parity_values,
        lambda index: parity * identity if index is shape.source() else parity,
    )
    factor = construction.factor(cocone).apex_map()
    assert factor.domain() is quotient and factor.codomain() is parity_values
    assert factor(projection(integers(0))) == parity_values(0)
    assert factor(projection(integers(1))) == parity_values(1)
    assert factor(projection(integers(2))) == parity_values(0)


def test_singleton_target_coequalizes_an_unenumerated_infinite_relation_exactly() -> None:
    integers, point = ZZ, Sets.Δ[0]
    left = Sets().Mor(integers, point)(lambda _n: point(0))
    right = Sets().Mor(integers, point)(lambda _n: point(0))
    construction = Sets().coequalizer_construction(left, right)
    shape = construction.diagram().domain()
    projection = construction.costructure_morphism(shape.target())

    assert construction.object() is point
    assert construction.object().cardinality() == cardinal(1)
    assert projection.domain() is point and projection.codomain() is point
    assert projection(point(0)) == point(0)

    target = Sets.Δ[1]
    target_map = Sets().Mor(point, target)(lambda _p: target(1))
    cocone = construction.diagram().Cocones().cocone(
        target,
        lambda vertex: target_map * left if vertex is shape.source() else target_map,
    )
    factor = construction.factor(cocone).apex_map()
    assert factor.domain() is point and factor.codomain() is target
    assert factor(point(0)) == target(1)


def test_wide_infinite_source_coequalizer_retains_every_relation_map() -> None:
    r"""The family n, n+2, n+4 on ZZ induces one coequalizer with a parity factor."""
    from dzack_research.preamble.categories.sets.indexed_families import indexed_family

    integers = ZZ
    maps = (
        Sets().Mor(integers, integers).identity(),
        Sets().Mor(integers, integers)(lambda n: integers(n + integers(2))),
        Sets().Mor(integers, integers)(lambda n: integers(n + integers(4))),
    )
    family = indexed_family(Sets.Δ[2], lambda index: maps[int(index)])
    construction = Sets().coequalizer_of_family_construction(family)
    shape = construction.diagram().domain()
    quotient = construction.object()
    projection = construction.costructure_morphism(shape.target())

    assert construction.diagram().morphisms() is family
    assert projection.domain() is integers and projection.codomain() is quotient
    assert quotient.left_morphism().domain().cardinality().is_finite() is False

    parity_values = Sets.Δ[1]
    parity = Sets().Mor(integers, parity_values)(lambda n: parity_values(int(n) % 2))
    cocone = construction.diagram().Cocones().cocone(
        parity_values,
        lambda index: parity * maps[0] if index is shape.source() else parity,
    )
    factor = construction.factor(cocone).apex_map()
    assert factor(projection(integers(0))) == parity_values(0)
    assert factor(projection(integers(3))) == parity_values(1)
