r"""The line bundles ``O(D)`` of torus-invariant divisors on the toric projective plane.

``H^0(P^n, O(d))`` is the space of degree-``d`` forms, of dimension
``binom(n + d, d)``, and ``0`` for ``d < 0`` (Hartshorne, *Algebraic Geometry*,
II.5.13 and III.5.1); ``omega_{P^n} = O(-n-1)`` (II.8.20.1).  Both checked
against the text in the Zotero library.  A torus-invariant line ``D`` of the
toric ``P^2`` has ``O(D) = O(1)``; ``O(1)`` is very ample, hence ample and
generated by global sections.
"""

from dzack_research.preamble.all import *  # noqa: F401,F403


def _plane():
    return RationalPolyhedralFans(ZZ.free_module(2)).projective_space_fan().toric_variety(QQ)


def _line(plane):
    return plane.torus_invariant_prime_divisor(next(iter(plane.fan().cones(1))))


def test_the_bundle_of_a_line_is_an_invertible_sheaf_with_that_divisor() -> None:
    r"""``O(D)`` is an invertible ``O_X``-module whose associated divisor is ``D``."""
    plane = _plane()
    line = _line(plane)
    bundle = plane.invertible_sheaf_of_divisor(line)

    assert bundle in QuasiCoherentSheaves(plane).Invertible()
    assert bundle.is_invertible()
    assert bundle.scheme() is plane
    assert bundle.associated_divisor() == line


def test_the_bundle_of_a_line_is_trivialized_on_the_three_torus_charts() -> None:
    r"""The affine charts of ``P^2`` are the ``U_sigma`` of its three maximal cones; each trivializes ``O(D)``."""
    plane = _plane()
    bundle = plane.invertible_sheaf_of_divisor(_line(plane))
    charts = bundle.chart_indices()

    assert charts == plane.fan().cones(2)
    for chart in charts:
        assert bundle.local_module(chart).module_rank() == 1


def test_sections_of_a_line_bundle_and_its_double_are_the_linear_and_quadratic_forms() -> None:
    r"""``h^0(O(1)) = 3`` and ``h^0(O(2)) = 6`` on ``P^2``."""
    plane = _plane()
    line = _line(plane)

    assert plane.invertible_sheaf_of_divisor(line).global_sections().dimension() == 3
    assert plane.invertible_sheaf_of_divisor(2 * line).global_sections().dimension() == 6
    assert plane.O1().global_sections().dimension() == 3


def test_the_canonical_bundle_of_the_plane_has_no_sections() -> None:
    r"""``omega_{P^2} = O(-3)`` has ``h^0 = 0``, and is ``O(K)`` for ``K = -sum D_rho``."""
    plane = _plane()
    canonical = plane.canonical_line_bundle()

    assert canonical.associated_divisor() == plane.canonical_divisor()
    assert canonical.global_sections().dimension() == 0


def test_the_bundle_of_a_line_is_ample_and_generated_by_sections() -> None:
    r"""``O(1)`` on ``P^2`` is very ample, hence ample and basepoint free."""
    plane = _plane()
    line = _line(plane)

    assert plane.is_basepoint_free(line)
    assert plane.is_ample(line)


def test_the_square_of_the_bundle_of_a_line_is_the_bundle_of_twice_the_line() -> None:
    r"""``O(D)^{(x) 2} = O(2D)``, with ``h^0 = 6``."""
    plane = _plane()
    line = _line(plane)
    square = plane.invertible_sheaf_of_divisor(line).tensor_power(2)

    assert square.associated_divisor() == 2 * line
    assert square.global_sections().dimension() == 6


def test_the_dual_of_the_bundle_of_a_line_has_no_sections() -> None:
    r"""``O(D)^dual = O(-D) = O(-1)``, with ``h^0 = 0``; ``O(D) (x) O(-D) = O`` has ``h^0 = 1``."""
    plane = _plane()
    bundle = plane.invertible_sheaf_of_divisor(_line(plane))
    dual = bundle.dual_sheaf()

    assert dual.global_sections().dimension() == 0
    assert bundle.tensor_product(dual).global_sections().dimension() == 1


def test_transition_units_of_a_line_bundle_satisfy_the_cocycle_condition() -> None:
    r"""``g_{ij} g_{jk} = g_{ik}`` and ``g_{ij} g_{ji} = 1`` for the transition units of ``O(D)``."""
    plane = _plane()
    bundle = plane.invertible_sheaf_of_divisor(_line(plane))
    first, second, third = bundle.chart_indices()

    assert bundle.transition_unit(first, second) * bundle.transition_unit(second, third) == bundle.transition_unit(first, third)
    assert (bundle.transition_unit(first, second) * bundle.transition_unit(second, first)).is_one()
