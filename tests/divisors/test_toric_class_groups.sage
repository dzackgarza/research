r"""Class groups of toric surfaces from their fans.

``M -> Div_T(X) -> Cl(X) -> 0`` is exact, ``Div_T(X)`` free on the rays; so
``Cl(P^2) = Z^3 / Z^2 = Z``, generated by any torus-invariant line, with the
boundary ``sum D_rho`` of class ``3H`` and ``K = -sum D_rho`` of class ``-3H``;
``Cl(A^2) = 0``.  The quadric cone ``xy = z^2`` is the toric surface of
``Cone((1,0),(1,2))`` and has ``Cl = Z/2`` (Hartshorne, *Algebraic Geometry*,
Example II.6.5.2, checked against the text in the Zotero library).
"""

from dzack_research.preamble.all import *  # noqa: F401,F403


def test_the_three_torus_invariant_lines_of_the_plane_share_one_nonzero_class() -> None:
    r"""``div(chi^m) = <m, u_0> D_0 + <m, u_1> D_1 + <m, u_2> D_2`` identifies the three lines in ``Cl P^2``."""
    fans = RationalPolyhedralFans(ZZ.free_module(2))
    plane = fans.projective_space_fan().toric_variety(QQ)
    first, second, third = (
        plane.divisor_class(plane.torus_invariant_prime_divisor(ray)) for ray in plane.fan().cones(1)
    )

    assert first == second
    assert second == third
    assert first != plane.class_group().zero()
    assert plane.class_group() in ClassGroups()


def test_the_boundary_is_three_lines_and_the_canonical_class_is_minus_three_lines() -> None:
    r"""``[sum D_rho] = 3H`` and ``[K_{P^2}] = -3H``."""
    fans = RationalPolyhedralFans(ZZ.free_module(2))
    plane = fans.projective_space_fan().toric_variety(QQ)
    line = plane.divisor_class(plane.torus_invariant_prime_divisor(next(iter(plane.fan().cones(1)))))

    assert plane.divisor_class(plane.toric_boundary_divisor()) == 3 * line
    assert plane.divisor_class(plane.canonical_divisor()) == -3 * line


def test_the_torus_invariant_weil_divisors_of_the_plane_are_free_on_its_three_rays() -> None:
    r"""``Div_T(P^2) = Z^3``, one generator for each ray of the fan."""
    fans = RationalPolyhedralFans(ZZ.free_module(2))
    plane = fans.projective_space_fan().toric_variety(QQ)
    weil = plane.weil_divisor_group()

    assert weil in WeilDivisorGroups()
    assert weil.divisor_scheme() is plane
    assert weil.prime_divisor_locus() == plane.fan().cones(1)
    assert weil.module_rank() == 3


def test_the_class_group_of_the_affine_plane_is_trivial() -> None:
    r"""``Cl(A^2) = 0``: the two rays of ``Cone(e_1, e_2)`` are a basis of ``N``."""
    fans = RationalPolyhedralFans(ZZ.free_module(2))
    affine_plane = fans((((1, 0), (0, 1)),)).toric_variety(QQ)

    assert affine_plane.class_group().cardinality() == 1


def test_the_class_group_of_the_quadric_cone_has_order_two() -> None:
    r"""``Cl`` of the ``A_1`` cone is ``Z^2 / <(1, 1), (0, 2)> = Z/2``."""
    fans = RationalPolyhedralFans(ZZ.free_module(2))
    cone_surface = fans((((1, 0), (1, 2)),)).toric_variety(QQ)

    assert cone_surface.class_group().cardinality() == 2


def test_the_class_group_of_the_quadric_cone_is_torsion() -> None:
    r"""``Cl = Z/2`` has rank zero and is its own torsion submodule."""
    fans = RationalPolyhedralFans(ZZ.free_module(2))
    classes = fans((((1, 0), (1, 2)),)).toric_variety(QQ).class_group()

    assert classes.module_rank() == 0
    assert classes.torsion_submodule().cardinality() == 2


def test_the_class_group_of_the_quadric_surface_is_free() -> None:
    r"""``Cl(P^1 x P^1) = Z^2`` (Hartshorne, Example II.6.6.1)."""
    fans = RationalPolyhedralFans(ZZ.free_module(2))
    quadric = fans.hirzebruch_surface_fan(0).toric_variety(QQ)

    assert quadric.class_group().is_free()
    assert quadric.class_group().module_rank() == 2
