r"""The double cover ``z^2 = x^4 - 1`` of the affine line over ``Q`` and its deck involution.

For ``B = A[z]/(z^n - f)`` over ``A = Q[x]`` the relative differentials are generated by ``dz``
with the single relation ``n z^{n-1} dz = 0``; the deck group ``mu_n(Q)`` for ``n = 2`` is
``{1, -1}`` acting by ``z -> -z``; the invariants are the degree-zero summand ``A``.  Each
claim below follows from these presentations.
"""

from dzack_research.preamble.all import *


def test_the_deck_group_of_a_double_cover_over_q_is_generated_by_minus_one() -> None:
    r"""``-1`` is the primitive square root of unity in ``Q``, and the constant deck group is ``C_2``."""
    line_ring = QQ["x"]
    covers = CyclicCovers(line_ring, 2)

    assert covers.cover_degree() == 2
    assert covers.deck_root_of_unity() == -1
    assert covers.constant_deck_group().order() == 2


def test_the_double_cover_is_a_curve_with_z_squared_equal_to_the_branch_section() -> None:
    r"""``Spec Q[x, z]/(z^2 - x^4 + 1)`` is one-dimensional, and ``z^2 = x^4 - 1`` in its coordinate ring."""
    line_ring = QQ["x"]
    x = line_ring.algebra_generator("x")
    cover = CyclicCovers(line_ring, 2)(x**4 - 1)
    z = cover.cover_variable()

    assert z**2 == cover.coordinate_algebra()(x**4 - 1)
    assert cover.dimension() == 1
    assert cover.relative_dimension() == 0


def test_the_deck_involution_negates_z_and_squares_to_the_identity() -> None:
    r"""The generator of ``C_2`` acts by ``z -> -z``, ``x -> x``."""
    line_ring = QQ["x"]
    x = line_ring.algebra_generator("x")
    covers = CyclicCovers(line_ring, 2)
    cover = covers(x**4 - 1)
    z = cover.cover_variable()
    sigma = cover.constant_deck_transformation(covers.constant_deck_group().group_generators()[0])

    assert sigma.coordinate_algebra_morphism()(z) == -z
    assert sigma.coordinate_algebra_morphism()(cover.coordinate_algebra()(x)) == cover.coordinate_algebra()(x)
    assert sigma * sigma == cover.categorical_identity_morphism()


def test_the_branch_locus_is_zero_dimensional_and_the_cover_is_ramified() -> None:
    r"""The branch subscheme ``V(x^4 - 1)`` of the line is a finite set of points; the ramification
    scheme ``V(2z)`` is nonempty, so the cover is not étale, while ``z^2 = 1`` is étale."""
    line_ring = QQ["x"]
    x = line_ring.algebra_generator("x")
    covers = CyclicCovers(line_ring, 2)
    cover = covers(x**4 - 1)

    assert cover.branch_subscheme().dimension() == 0
    assert cover.ramification_subscheme().dimension() == 0
    assert not cover.is_etale_cover()
    assert covers.an_object().is_etale_cover()


def test_the_quotient_by_the_deck_involution_is_the_line() -> None:
    r"""The invariants of ``z -> -z`` on ``Q[x, z]/(z^2 - f)`` are ``Q[x]``."""
    line_ring = QQ["x"]
    x = line_ring.algebra_generator("x")
    cover = CyclicCovers(line_ring, 2)(x**4 - 1)

    assert cover.invariant_algebra() == line_ring
    assert cover.affine_quotient().dimension() == 1
