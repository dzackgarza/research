r"""$SL_2(\mathbb{Z})$ is generated by $S$ and $T$ with $S^2 = (ST)^3 = -I$."""

from dzack_research.preamble.all import *  # noqa: F401,F403


def test_the_generators_s_and_t_of_sl2z_satisfy_the_modular_relations() -> None:
    r"""$S = \begin{psmallmatrix}0&-1\\1&0\end{psmallmatrix}$ has order $4$, $ST$ has order $6$, and $S^2 = (ST)^3 = -I$.

    $S$ and $T$ generate $SL_2(\mathbb{Z})$, so it is finitely generated.
    Source: Serre, *A Course in Arithmetic*, VII.1, Theorem 2.
    """
    group = Groups.SL(2, ZZ)
    S = group([[0, -1], [1, 0]])
    T = group([[1, 1], [0, 1]])
    minus_one = group([[-1, 0], [0, -1]])

    assert S.order() == 4
    assert (S * T).order() == 6
    assert S**2 == minus_one
    assert (S * T) ** 3 == minus_one
    assert T.order() == oo
    assert group.is_finitely_generated()
