r"""Schreier words are selected free-group augmentations, not bare tuples."""

from dzack_research.preamble.all import *  # noqa: F401,F403


def test_kernel_of_c4_to_c2_has_a_schreier_epimorphism() -> None:
    four, two = Groups.C(4), Groups.C(2)
    s, t = next(iter(four.group_generators())), next(iter(two.group_generators()))
    reduction = four.Mor(two)({s: t})
    kernel = reduction.kernel()
    augmentation = kernel.schreier_generating_morphism()
    words = kernel.schreier_generators()

    assert augmentation.domain().free_basis() == words.index_set()
    assert augmentation.codomain() is kernel
    assert words.index_set() in FiniteSets()
    assert all(reduction(augmentation(g)) == two.one() for g in augmentation.domain().group_generators())
    assert all(augmentation(augmentation.domain().free_generator(label)) == words.value(label) for label in words.index_set())
    assert four.subgroup(augmentation(g) for g in augmentation.domain().group_generators()).cardinality() == cardinal(2)


def test_preimage_schreier_generators_keep_the_free_basis_index() -> None:
    four = Groups.C(4)
    s = next(iter(four.group_generators()))
    subgroup = four.subgroup((s**2,))
    identity = four.Mor(four).identity()
    preimage = identity.preimage_subgroup(subgroup)
    augmentation = preimage.schreier_generating_morphism()
    words = preimage.schreier_generators()

    assert augmentation.domain().free_basis() == words.index_set()
    assert augmentation.codomain() is preimage
    assert words.index_set() == augmentation.domain().group_generating_set()
    assert all(augmentation(g) in preimage for g in augmentation.domain().group_generators())


def test_finite_index_predicate_subgroup_has_a_selected_generating_epimorphism() -> None:
    r"""The transposition subgroup C2 of S3 has index three and a free cover."""
    group = Groups.S(3)
    transposition = group((1, 2))
    actual = group.subgroup((transposition,))
    predicate = group.predicate_subgroup(
        lambda element: element in actual,
        "subgroup generated by the transposition (1 2)",
    )
    words = predicate.finite_index_schreier_generators(index_bound=3)
    augmentation = predicate.finite_index_schreier_generating_morphism(index_bound=3)

    assert augmentation.codomain() is predicate
    assert augmentation.domain().free_basis() == words.index_set()
    assert all(augmentation(augmentation.domain().free_generator(i)) in predicate for i in words.index_set())
    assert group.subgroup(tuple(augmentation(g) for g in augmentation.domain().group_generators())).cardinality() == cardinal(2)


def test_finite_index_kernel_of_parity_on_free_group_has_a_free_cover() -> None:
    free, two = Groups.Free(1), Groups.C(2)
    label = next(iter(free.free_basis()))
    generator = free.free_generator(label)
    involution = next(iter(two.group_generators()))
    reduction = free.Mor(two)({label: involution})
    predicate = free.predicate_subgroup(
        lambda element: reduction(element) == two.one(), "even exponent sum"
    )
    augmentation = predicate.finite_index_schreier_generating_morphism(index_bound=2)

    assert augmentation.codomain() is predicate
    assert any(
        augmentation(g) == generator**2 or augmentation(g) == generator**(-2)
        for g in augmentation.domain().group_generators()
    )
    assert all(reduction(augmentation(g)) == two.one() for g in augmentation.domain().group_generators())
