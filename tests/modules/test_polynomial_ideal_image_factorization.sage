r"""Image, kernel and cokernel of (x,y): QQ[x,y]^2 -> QQ[x,y].

The image is the ideal (x,y), the kernel is generated by (-y,x)
and the cokernel is the quotient by (x,y), with their defining maps.
Terminal-phase T supplies execution of these independent specimens.
"""

from dzack_research.preamble.all import *  # noqa: F401,F403


def _polynomial_linear_map():
    ring = QQ["x,y"]
    x, y = ring.algebra_generators()
    source, target = ring.free_module(2), ring.regular_module()
    a, b = tuple(source.module_generating_set())
    (one,) = tuple(target.module_generators())
    morphism = source.module_category().Mor(source, target)({
        a: target.scalar_multiple(x, one),
        b: target.scalar_multiple(y, one),
    })
    return ring, x, y, source, target, a, b, morphism


def test_polynomial_map_image_is_the_ideal_with_its_inclusion() -> None:
    ring, x, y, source, target, a, b, morphism = _polynomial_linear_map()
    ideal = morphism.image()
    inclusion = ideal.inclusion()
    epimorphism = morphism.factor_through(inclusion)

    assert ideal in CommutativeIdeals(ring)
    assert ideal in ModuleSubobjects(ring)
    assert ideal == ring.ideal(x, y)
    assert ideal is morphism.image()
    assert inclusion.domain() is ideal and inclusion.codomain() is target
    assert epimorphism.domain() is source and epimorphism.codomain() is ideal
    assert all(
        inclusion(epimorphism(source.module_generator(label)))
        == morphism(source.module_generator(label))
        for label in (a, b)
    )
    (one,) = tuple(target.module_generators())
    assert inclusion.is_in_image(target.scalar_multiple(x + y, one))
    assert not inclusion.is_in_image(one)


def test_polynomial_map_kernel_is_exactly_the_principal_syzygy() -> None:
    ring, x, y, source, _target, a, b, morphism = _polynomial_linear_map()
    syzygy = source.linear_combination({a: -y, b: x})
    kernel = morphism.kernel()
    inclusion = kernel.inclusion()
    assert morphism(syzygy) == morphism.codomain().zero()
    assert inclusion.domain() is kernel and inclusion.codomain() is source
    assert inclusion.is_in_image(syzygy)
    # The maintained polynomial-presentation kernel must supply the cyclic
    # presentation itself, rather than request a PID submodule basis over
    # the non-PID ring QQ[x,y]. A unit coefficient means the displayed
    # syzygy generates this represented cyclic kernel.
    (kernel_label,) = tuple(kernel.module_generating_set())
    coefficient = kernel.framing_morphism().lift(
        inclusion.lift(syzygy)
    )(kernel_label)
    assert coefficient.is_unit()


def test_polynomial_map_cokernel_is_the_quotient_by_xy() -> None:
    ring, x, y, source, target, a, b, morphism = _polynomial_linear_map()
    quotient = morphism.cokernel()
    projection = morphism.cokernel_projection()
    (one,) = tuple(target.module_generators())

    assert projection.domain() is target and projection.codomain() is quotient
    assert projection(target.scalar_multiple(x, one)) == quotient.zero()
    assert projection(target.scalar_multiple(y, one)) == quotient.zero()
    assert projection(one) != quotient.zero()
    assert all(
        projection(morphism(source.module_generator(label))) == quotient.zero()
        for label in (a, b)
    )
    assert ring.quotient_ring(ring.ideal(x, y)).krull_dimension() == 0
