r"""Splitting an ``O(L)``-orbit of marked lattices into the orbits of a finite-index subgroup.

``L = <2> + <2>`` has basis ``e1, e2`` with ``b(ei, ej) = 2 delta_ij``.  Its
isometries are the signed permutations of ``e1, e2``, so ``G = O(L)`` is the
dihedral group of order 8.  The discriminant group ``A_L = L^#/L`` is
``(ZZ/2)^2``, generated by ``e1/2, e2/2``, with ``q(e1/2) = q(e2/2) = 1/2`` and
``q(e1/2 + e2/2) = 1`` in ``QQ/2ZZ``; ``O(A_L)`` is the order-two group
exchanging ``e1/2`` and ``e2/2``.  A sign change fixes each ``ei/2`` modulo
``L`` and the swap exchanges them, so ``H = ker(O(L) -> O(A_L))`` is the group
of the four sign changes, of index two.

The pointed lattice ``(L, 1 |-> e1)`` has ``G``-orbit ``{+-e1, +-e2}`` and
stabilizer ``G_m = {1, e2 |-> -e2}``.  ``H`` carries ``e1`` only to ``+-e1``,
so the ``G``-orbit splits into the two ``H``-orbits of ``e1`` and of ``e2``:
``|H \ G / G_m| = 2``.  With ``H = G`` it is one orbit.  ``SO(L)`` (the four
rotations, the kernel of the determinant) contains the rotation
``e1 |-> e2 |-> -e1``, so it does not split the orbit, although it is a
proper subgroup of index two.  The same counts hold for the sublattice
``ZZ e1`` (setwise stabilizer: the sign changes) and for the flag
``ZZ e1 -> L -> L``.  Each count is the elementary derivation above.
"""

import pytest

from dzack_research.preamble.all import *
from dzack_research.preamble.categories.abstract_categories.products import FiniteOrdinalCategory


def _lattice():
    return Lattices(ZZ)([[2, 0], [0, 2]])


def _pointed(lattice, vector):
    source = Lattices(ZZ)([[lattice.q(vector)]])
    category = Lattices(ZZ).CosliceUnder(source)
    return category, category.object(source.Mor(lattice)(lambda _label: vector))


def test_the_pointed_orbit_of_e1_splits_into_the_orbits_of_e1_and_e2_under_the_stable_group() -> None:
    lattice = _lattice()
    e1, e2 = lattice.module_generators()
    group = lattice.O()
    stable = lattice.stable_orthogonal_group()
    category, marked = _pointed(lattice, e1)
    source = category.base_object()
    generator = source.module_generator(next(iter(source.module_generating_set())))

    split = group.split_orbit(marked, stable)

    assert split.cardinality() == 2
    vectors = [category.arrow(representative)(generator) for representative in split]
    assert all(group.vectors_are_equivalent(vector, e1) for vector in vectors)
    assert not stable.vectors_are_equivalent(vectors[0], vectors[1])
    assert any(stable.vectors_are_equivalent(vector, e1) for vector in vectors)
    assert any(stable.vectors_are_equivalent(vector, e2) for vector in vectors)


def test_each_split_representative_keeps_its_stabilizer_in_the_stable_group() -> None:
    r"""``H cap g G_m g^-1`` for ``g . m`` at ``+-e1`` or ``+-e2``: ``{1, the other sign change}``, of order 2."""
    lattice = _lattice()
    e1, _e2 = lattice.module_generators()
    stable = lattice.stable_orthogonal_group()
    category, marked = _pointed(lattice, e1)

    for representative in lattice.O().split_orbit(marked, stable):
        assert stable.intersection(category.apex_stabilizer(representative)).cardinality() == 2


def test_the_whole_orthogonal_group_and_the_rotations_do_not_split_the_pointed_orbit() -> None:
    lattice = _lattice()
    e1, _e2 = lattice.module_generators()
    group = lattice.O()
    _category, marked = _pointed(lattice, e1)

    assert group.split_orbit(marked, group).cardinality() == 1
    assert group.split_orbit(marked, lattice.SO()).cardinality() == 1


def test_the_orbit_of_the_line_through_e1_splits_under_the_stable_group() -> None:
    lattice = _lattice()
    e1, _e2 = lattice.module_generators()
    group = lattice.O()
    sublattices = Lattices(ZZ).ArrowCategory()
    marked = sublattices.object(lattice.subobject_on([e1]).inclusion())

    assert group.split_orbit(marked, lattice.stable_orthogonal_group()).cardinality() == 2
    assert group.split_orbit(marked, group).cardinality() == 1


def test_the_orbit_of_a_flag_splits_under_the_stable_group() -> None:
    lattice = _lattice()
    e1, e2 = lattice.module_generators()
    group = lattice.O()
    flags = Cat().Mor(FiniteOrdinalCategory(3), Lattices(ZZ))
    line = lattice.subobject_on([e1])
    whole = lattice.subobject_on([e1, e2])
    line_into_whole = line.Emb(whole)(line.inclusion().factor_through(whole.inclusion()))
    marked = flags.object((line_into_whole, whole.inclusion()))

    assert group.split_orbit(marked, lattice.stable_orthogonal_group()).cardinality() == 2
    assert group.split_orbit(marked, group).cardinality() == 1


def test_a_subgroup_given_by_generators_has_no_character_quotient_to_split_along() -> None:
    r"""``<swap>`` is a subgroup given by its generator, not by characters of ``O(L)``."""
    lattice = _lattice()
    e1, e2 = lattice.module_generators()
    group = lattice.O()
    labels = lattice.module_generating_set()
    swap = group({labels[0]: e2, labels[1]: e1})
    _category, marked = _pointed(lattice, e1)

    with pytest.raises(AssertionError, match="kernel of such a character map"):
        group.split_orbit(marked, group.subgroup((swap,)))
