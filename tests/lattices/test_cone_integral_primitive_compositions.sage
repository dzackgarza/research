r"""A simplicial cone of determinant two and a unit square.

The cone generated by (0,1),(2,1) is already simplicial; its ray
lattice has index two in Z² by the determinant. Its subcone inclusion
fixes every point. The integral points of [0,1]² are exactly its corners.
"""

from dzack_research.preamble.all import *


def test_a_simplicial_cone_retains_its_inclusion_and_ray_lattice_index():
    lattice = Lattices(ZZ)([[1, 0], [0, 1]])
    cone = lattice.reduction_cell(((1, 0), (-1, 2)))
    triangulation = cone.triangulation()
    first, second = cone.ambient_space().module_generators()

    assert triangulation.index_set().cardinality() == 1
    for simplex in triangulation.index_set():
        subcone = triangulation.value(simplex)
        inclusion = cone.simplicial_subcone_inclusion(simplex)
        assert inclusion.domain() is subcone
        assert inclusion.codomain() is cone
        assert cone.ray_span_saturation_index(subcone) == 2
        for rational_ray in (second, 2 * first + second):
            assert inclusion(rational_ray) == rational_ray


def test_the_unit_square_has_exactly_its_four_integral_corners():
    module = ZZ.free_module(2)
    first, second = module.module_generators()
    square = ConvexPolytopes(module)(((0, 0), (1, 0), (0, 1), (1, 1)))

    assert Set(square.integral_points()) == Set((module.zero(), first, second, first + second))
