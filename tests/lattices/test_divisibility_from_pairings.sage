r"""The divisibility of a lattice vector is the gcd of its pairings with a basis.

\(\operatorname{div}(v)\) is the positive generator of the ideal \(b(v,L)\), which is
generated by the pairings \(b(v,e_i)\) with a basis.  In \(A_2\) (Gram
\(\begin{pmatrix}-2&1\\1&-2\end{pmatrix}\)): \(b(e_0,\cdot) = (-2,1)\), so
\(\operatorname{div}(e_0)=1\); \(b(e_0-e_1,\cdot) = (-3,3)\), so
\(\operatorname{div}(e_0-e_1)=3\), and \(\operatorname{div}(2(e_0-e_1)) = 6\).  In \(U\) every
primitive vector has divisibility 1, since \(U\) is unimodular.
"""

from dzack_research.preamble.all import *


def test_the_pairings_of_a_simple_root_of_a2_with_the_basis() -> None:
    lattice = Lattices(ZZ)("A2")
    first, second = lattice.module_generators()
    pairings = lattice.generator_pairings(first)

    assert sum(pairings.values()) == -1
    assert lattice.div(first) == 1
    assert first.div() == 1


def test_the_difference_of_the_simple_roots_of_a2_is_three_divisible() -> None:
    lattice = Lattices(ZZ)("A2")
    first, second = lattice.module_generators()
    difference = first - second

    for value in lattice.generator_pairings(difference).values():
        assert value % 3 == 0
    assert lattice.div(difference) == 3
    assert lattice.div(2 * difference) == 6


def test_primitive_vectors_of_the_unimodular_plane_have_divisibility_one() -> None:
    plane = Lattices(ZZ)("U")
    e, f = plane.module_generators()

    for vector in (e, f, e + f, e - f, 2 * e + 3 * f):
        assert plane.div(vector) == 1
    assert plane.div(4 * e + 6 * f) == 2
