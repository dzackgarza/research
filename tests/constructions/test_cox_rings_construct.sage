r"""The Cox ring of P^2 is generated by its three torus-invariant prime divisors."""

from dzack_research.preamble.all import *  # noqa: F401,F403


def test_projective_plane_cox_ring() -> None:
    plane = RationalPolyhedralFans(ZZ.free_module(2)).projective_space_fan().toric_variety(QQ)
    cox = plane.cox_ring()

    assert cox in CoxRings(plane)
    assert cox.cox_scheme() is plane
    assert cox.algebra_generating_set().cardinality() == cardinal(3)
    assert cox.grading_monoid() is plane.class_group()
