r"""Vector configurations as framed lattice subobjects.

The two simple roots of ``A2`` form a basis of their lattice and have Gram
matrix ``[[2,-1],[-1,2]]``.  Their configuration symmetry group therefore has
order two, generated by exchanging the roots, and every configuration
isometry lifts to an ambient isometry because the framing is a basis.
"""

from dzack_research.preamble.all import *  # noqa: F401,F403


def _a2_configuration():
    lattice = Lattices(ZZ)("A2")
    basis = tuple(lattice.module_generator(i) for i in range(2))
    sublattice = lattice.subobject_on(basis)
    return VectorConfigurations(ZZ)(sublattice)


def test_vector_configuration_retains_its_framing_and_pairing_data() -> None:
    configuration = _a2_configuration()
    positions = configuration.configuration_positions()
    canonical = configuration.canonical_pairing_matrix()
    position_map = configuration.canonical_position_map()

    assert configuration in VectorConfigurations(ZZ)
    assert configuration in ModuleSubobjects(ZZ)
    assert configuration.module_rank() == 2
    assert positions.cardinality() == cardinal(2)
    assert isinstance(configuration.module_generator(0), configuration.ElementType)
    assert configuration.frames_its_lattice()
    assert canonical == configuration.gram_matrix()
    assert configuration.preserves_every_pairing(position_map)


def test_a2_configuration_has_the_two_root_symmetries_and_their_isometries() -> None:
    configuration = _a2_configuration()
    automorphisms = configuration.configuration_automorphism_group()
    identity = automorphisms.identity()
    configuration_identity = configuration.configuration_isometry_from_automorphism(identity)
    ambient_identity = configuration.ambient_isometry_from_automorphism(identity)
    diagram_isometries = tuple(configuration.diagram_automorphism_isometries())

    assert automorphisms.order() == 2
    assert configuration_identity(configuration.module_generator(0)) == configuration.module_generator(0)
    assert configuration_identity(configuration.module_generator(1)) == configuration.module_generator(1)
    assert ambient_identity(configuration.inclusion()(configuration.module_generator(0))) == configuration.inclusion()(configuration.module_generator(0))
    assert len(diagram_isometries) == 2


def test_canonical_position_map_lifts_to_configuration_and_ambient_isometries() -> None:
    configuration = _a2_configuration()
    position_map = configuration.canonical_position_map()
    internal = configuration.configuration_isometry(position_map)
    ambient = configuration.ambient_isometry(position_map)

    assert internal.domain() is configuration
    assert internal.codomain() is configuration
    assert ambient.domain() is configuration.ambient_module()
    assert ambient.codomain() is configuration.ambient_module()


def test_vector_configuration_morphisms_have_identity() -> None:
    configuration = _a2_configuration()
    identity = configuration.Mor(configuration).identity()

    assert identity(configuration.module_generator(0)) == configuration.module_generator(0)
    assert identity * identity == identity
