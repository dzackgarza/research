r"""Module subobjects retain their inclusion into the ambient module.

Inside ``ZZ^2``, the submodule generated by ``2e_0,e_1`` has index two and
saturates to the whole module.  Coordinate lines give transverse subobjects,
whose intersection is zero and whose sum is the ambient module.
"""

from dzack_research.preamble.all import *  # noqa: F401,F403


def _index_two_submodule():
    module = ZZ.free_module(2)
    e0, e1 = module.module_generator(0), module.module_generator(1)
    return module, e0, e1, module.subobject_on((2 * e0, e1))


def test_module_subobject_retains_ambient_inclusion_generators_and_construction() -> None:
    module, _e0, _e1, submodule = _index_two_submodule()
    inclusion = submodule.inclusion()
    construction = submodule.module_subobject_construction()

    assert submodule in ModuleSubobjects(ZZ)
    assert submodule.ambient_module() is module
    assert inclusion.codomain() is module
    assert inclusion.domain() is submodule
    assert submodule.embedded_module_generators().cardinality() == cardinal(2)
    assert construction is not None
    assert isinstance(submodule.module_generator(0), submodule.ElementType)


def test_index_two_submodule_is_not_primitive_and_saturates_to_the_plane() -> None:
    module, e0, e1, submodule = _index_two_submodule()
    saturation = submodule.saturation()

    assert submodule.index() == 2
    assert not submodule.is_saturated()
    assert not submodule.is_primitive()
    assert saturation == module.subobject_on((e0, e1))
    assert saturation.index() == 1


def test_coordinate_lines_have_zero_intersection_and_sum_to_the_plane() -> None:
    module = ZZ.free_module(2)
    e0, e1 = module.module_generator(0), module.module_generator(1)
    first = module.subobject_on((e0,))
    second = module.subobject_on((e1,))

    assert first.intersection(second).cardinality() == 1
    assert first.sum(second) == module.subobject_on((e0, e1))


def test_orthogonal_complement_is_available_for_formed_module_subobjects() -> None:
    lattice = Lattices(ZZ)("A2")
    root = lattice.module_generator(0)
    line = lattice.subobject_on((root,))
    complement = line.orthogonal_complement()

    assert complement.inclusion().codomain() is lattice
    assert lattice.b(line.inclusion()(line.module_generator(0)), complement.inclusion()(complement.module_generator(0))) == 0


def test_module_subobject_morphisms_have_identity() -> None:
    _module, _e0, _e1, submodule = _index_two_submodule()
    identity = submodule.Mor(submodule).identity()

    assert identity(submodule.module_generator(0)) == submodule.module_generator(0)
    assert identity * identity == identity
