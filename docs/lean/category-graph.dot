// Modules, forms, lattices, and their core-level invariants.
// Every visible edge names a functor or map with the displayed source and target.
// THIS FILE IS THE MANIFEST. Edit it, then `just graph` regenerates the interactive SVG.
digraph G {
  rankdir=BT;
  compound=true;
  graph [
    bgcolor="#ffffff",
    fontname="Helvetica",
    fontsize=14,
    nodesep=0.30,
    ranksep=0.55,
    pad=0.18,
    splines=polyline
  ];
  node [
    shape=box,
    style="rounded,filled",
    fontname="Helvetica",
    fontsize=12,
    margin="0.10,0.07"
  ];
  edge [
    color="#64748b",
    fontcolor="#334155",
    fontname="Helvetica",
    fontsize=10,
    arrowsize=0.75
  ];

  subgraph cluster_modules {
    label=<modules and scalar extension along φ : R → S>;
    color="#a21caf";
    fontcolor="#701a75";
    node [fillcolor="#fae8ff", color="#a21caf"];
    RMod [label="R-Mod"];
    SMod [label="S-Mod"];
    RSBimod [label="(R,S)-Bimod"];
    SopMod [label="Sᵒᵖ-Mod"];
  }

  subgraph cluster_forms {
    label="form categories over R";
    color="#be123c";
    fontcolor="#881337";
    node [fillcolor="#ffe4e6", color="#be123c"];
    Bil [label=<𝓑<SUB>R,W</SUB> = El(Bil<SUB>R,W</SUB>)>];
    Quad [label=<𝓠<SUB>R,W</SUB> = El(Quad<SUB>R,W</SUB>)>];
    SymBil [label=<𝓑<SUB>R,W</SUB><SUP>sym</SUP>>];
    Nondeg [label=<𝓑<SUB>R,W</SUB><SUP>nd</SUP>>];
    SymNondeg [label=<𝓑<SUB>R,W</SUB><SUP>sym,nd</SUP>>];
    Perfect [label=<𝓑<SUB>R,W</SUB><SUP>perf</SUP>>];
  }

  subgraph cluster_lattices {
    label="integral lattices";
    color="#a16207";
    fontcolor="#713f12";
    node [fillcolor="#fef9c3", color="#a16207"];
    LatZ [label=<Lat<SUB>ℤ</SUB>>];
    EvenLatZ [label=<EvenLat<SUB>ℤ</SUB>>];
  }

  subgraph cluster_invariants {
    label="cores and invariants";
    color="#6d28d9";
    fontcolor="#4c1d95";
    node [fillcolor="#ede9fe", color="#6d28d9"];
    LatCore [label=<Lat<SUB>ℤ</SUB><SUP>≃</SUP>>];
    EvenLatCore [label=<EvenLat<SUB>ℤ</SUB><SUP>≃</SUP>>];
    DiscBilCore [label=<DiscBil<SUB>ℤ</SUB><SUP>≃</SUP>>];
    DiscQuadCore [label=<DiscQuad<SUB>ℤ</SUB><SUP>≃</SUP>>];
    LatClasses [label=<π<SUB>0</SUB>(Lat<SUB>ℤ</SUB><SUP>≃</SUP>)>, shape=ellipse];
    LocalClasses [
      label=<π<SUB>0</SUB>(Lat<SUB>ℝ</SUB><SUP>≃</SUP> × ∏<SUB>p</SUB> Lat<SUB>ℤₚ</SUB><SUP>≃</SUP>)>,
      shape=ellipse
    ];
  }

  RSBimod -> RMod [label="forget left"];
  RSBimod -> SopMod [label="forget right"];
  RMod -> SMod [label=<S ⊗<SUB>R</SUB> −>];

  Bil -> RMod [label="projection"];
  Quad -> RMod [label="projection"];
  SymBil -> Bil [label="inclusion"];
  Nondeg -> Bil [label="inclusion"];
  SymNondeg -> SymBil [label="inclusion"];
  SymNondeg -> Nondeg [label="inclusion"];
  Perfect -> Nondeg [label="inclusion"];
  SymBil -> Quad [label="diagonal"];
  Quad -> SymBil [label="polarization"];

  LatZ -> SymNondeg [label="inclusion, R = W = ℤ"];
  EvenLatZ -> LatZ [label="inclusion"];

  LatCore -> LatZ [label="core inclusion"];
  EvenLatCore -> EvenLatZ [label="core inclusion"];
  EvenLatCore -> LatCore [label="inclusion"];
  LatCore -> DiscBilCore [label="discriminant"];
  EvenLatCore -> DiscQuadCore [label="discriminant quadratic"];
  DiscQuadCore -> DiscBilCore [label="bilinearization"];
  LatCore -> LatClasses [label="π₀"];
  LatClasses -> LocalClasses [label="extension of scalars"];
}
