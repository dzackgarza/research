__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
node_modules/
.DS_Store
*.lock

*.sage.py

# Python build metadata: generated by every editable install, never source.
*.egg-info/
# setuptools' staging copy of the package it is building: a duplicate of the
# source next to it, so tracking it means two copies drifting apart.
build/
site/
writing/.book/_site/
writing/.assets/references.bib
writing/.assets/mathjax-macros.html

# Per-run test reports: a log, not source.
tests/.report/

# Jupyter collaboration runtime databases
.jupyter_ystore.db
.jupyter/
.virtual_documents/
.sage-tmp/
tags
.hypothesis/

# Per-directory render cache written by the book-toc filter on every Quarto render.
._htmlbook_xref.json

# LaTeX/tex4ht build intermediates from extracted reference papers.
writing/coble/papers/**/*.aux
writing/coble/papers/**/*.dvi
writing/coble/papers/**/*.log
writing/coble/papers/**/*.idv
writing/coble/papers/**/*.lg
writing/coble/papers/**/*.tmp
writing/coble/papers/**/*.xref
writing/coble/papers/**/*.4ct
writing/coble/papers/**/*.4tc

# `just docs-lint FILE` renders one page with pandoc's working directory at the
# page, so the .html lands beside the prose. It is a throwaway: the book's real
# output is writing/.book/_site/. The two checked-in .html under
# category-theory/lean/ are the generated category graph, listed in _quarto.yml
# as a project resource, so they are named rather than covered by this rule.
writing/coble/**/*.html

# Figures the book cites, staged from the pandoc-config clone by
# `scripts/docs_figures.py`. Authored and rendered there, collected here at build
# time like the bibliography and the MathJax macros.
writing/.book/rendered/

# Agent scratch. A turn's intermediate captures, plan dumps and validation logs
# live here and are deleted when the turn that made them is finished; nothing
# under these paths is an input to a later session.
.tmp/
.tmp-*
