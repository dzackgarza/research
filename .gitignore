__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
node_modules/
.DS_Store
*.lock

*.sage.py

# Python build metadata: generated by every editable install, never source.
*.egg-info/
# setuptools' staging copy of the package it is building: a duplicate of the
# source next to it, so tracking it means two copies drifting apart.
build/
site/
writing/_site/
writing/.quarto/
writing/references.bib
writing/_mathjax-macros.html

# Per-run test reports: a log, not source.
tests/.report/

# Jupyter collaboration runtime databases
.jupyter_ystore.db
.jupyter/
.virtual_documents/
.sage-tmp/
tags
.hypothesis/

# Per-directory render cache written by the book-toc filter on every Quarto render.
._htmlbook_xref.json

# LaTeX/tex4ht build intermediates from extracted reference papers.
writing/coble/papers/**/*.aux
writing/coble/papers/**/*.dvi
writing/coble/papers/**/*.log
writing/coble/papers/**/*.idv
writing/coble/papers/**/*.lg
writing/coble/papers/**/*.tmp
writing/coble/papers/**/*.xref
writing/coble/papers/**/*.4ct
writing/coble/papers/**/*.4tc
