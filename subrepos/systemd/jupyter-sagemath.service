[Unit]
Description=JupyterLab dynamic dashboard
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/dzack/research/computations
ExecStart=/bin/direnv exec /home/dzack /home/dzack/.local/bin/jupyter lab --IdentityProvider.password_required=False --IdentityProvider.hashed_password='' --IdentityProvider.token='' --ServerApp.disable_check_xsrf=True --ServerApp.local_hostnames=localhost --ServerApp.local_hostnames=jupyterlab.localhost --ServerApp.root_dir=/home/dzack/research/computations
Restart=on-failure
RestartSec=5
Environment=HOME=/home/dzack

[Install]
WantedBy=default.target
