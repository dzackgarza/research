r"""Subtree for divisor groups under the divisors category tree.

A divisor group Div(X) is a formed free $\mathbb{Z}$-module generated by prime divisors / codimension-1 cycles.
It carries the natural projection to the class group Cl(X) = Div(X) / Prin(X).
"""

from typing import Any

from sage.categories.category import Category


def DivisorGroup(formed: Any) -> FormModule:
    r"""Refine a free formed module as a divisor group."""
    assert isinstance(formed, FormModule), "DivisorGroup requires a formed module"
    refine(formed, [FreeFormModules(), DivisorGroups()])
    formed._initialize_framing()
    return formed


class DivisorGroups(Category):
    r"""Category of divisor groups (formed free $\mathbb{Z}$-modules)."""

    @classmethod
    def _repr_object_names(cls) -> str:
        return "divisor groups"

    def super_categories(self) -> list:
        r"""Return FreeFormModules(), of which divisor groups are formed free $\mathbb{Z}$-modules."""
        return [FreeFormModules()]

    class ParentMethods:
        r"""Divisor group parent methods."""

        def class_group(self: Any) -> Any:
            r"""Return the associated class group Cl(X) = Div(X) / Prin(X)."""
            raise NotImplementedError("class_group must be implemented by concrete DivisorGroup")

        def canonical_projection(self: Any) -> Any:
            r"""Return the canonical projection morphism Div(X) -> Cl(X)."""
            raise NotImplementedError("canonical_projection must be implemented by concrete DivisorGroup")

        def principal_submodule(self: Any) -> Any:
            r"""Return the submodule of principal divisors Prin(X) < Div(X)."""
            raise NotImplementedError("principal_submodule must be implemented by concrete DivisorGroup")

    class ElementMethods:
        r"""Divisor group element methods."""

        def to_class(self: Any) -> Any:
            r"""Map this divisor to its class in Cl(X)."""
            return self.parent().canonical_projection()(self)

        def is_principal(self: Any) -> bool:
            r"""Return whether this divisor is principal."""
            return self.to_class().is_zero()

        def intersection(self: Any, other: Any) -> Any:
            r"""Return $D_1 \cdot D_2$."""
            return self.b(other)

        def self_intersection(self: Any) -> Any:
            r"""Return $D^2$."""
            return self.norm()

    class MorphismMethods:
        r"""Divisor group morphism methods."""


def install_divisor_groups() -> None:
    r"""Register post-init hooks and installation for divisor groups."""
    pass
