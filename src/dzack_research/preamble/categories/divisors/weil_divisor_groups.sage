r"""Subtree for Weil divisor groups under the divisors category tree.

A Weil divisor group WeilDiv(X) is a formed free $\mathbb{Z}$-module generated by prime divisors.
Its quotient by principal Weil divisors is the Weil class group Cl(X) = WeilDiv(X) / Prin(X).
"""

from typing import Any

from sage.categories.category import Category


def WeilDivisorGroup(formed: Any) -> FormModule:
    r"""Refine a free formed module as a Weil divisor group."""
    assert isinstance(formed, FormModule), "WeilDivisorGroup requires a formed module"
    refine(formed, [FreeFormModules(), WeilDivisorGroups()])
    formed._initialize_framing()
    return formed


class WeilDivisorGroups(Category):
    r"""Category of Weil divisor groups."""

    @classmethod
    def _repr_object_names(cls) -> str:
        return "weil divisor groups"

    def super_categories(self) -> list:
        r"""Return FreeFormModules(), of which Weil divisor groups are formed free $\mathbb{Z}$-modules."""
        return [FreeFormModules()]

    class ParentMethods:
        r"""Weil divisor group parent methods."""

        def class_group(self: Any) -> Any:
            r"""Return the associated Weil class group Cl(X) = WeilDiv(X) / Prin(X)."""
            raise NotImplementedError("class_group must be implemented by concrete WeilDivisorGroup")

        def canonical_projection(self: Any) -> Any:
            r"""Return the canonical projection morphism WeilDiv(X) -> Cl(X)."""
            raise NotImplementedError("canonical_projection must be implemented by concrete WeilDivisorGroup")

        def principal_submodule(self: Any) -> Any:
            r"""Return the submodule of principal Weil divisors Prin(X) < WeilDiv(X)."""
            raise NotImplementedError("principal_submodule must be implemented by concrete WeilDivisorGroup")

    class ElementMethods:
        r"""Weil divisor group element methods."""

        def to_class(self: Any) -> Any:
            r"""Map this Weil divisor to its class in Cl(X)."""
            return self.parent().canonical_projection()(self)

        def is_principal(self: Any) -> bool:
            r"""Return whether this Weil divisor is principal."""
            return self.to_class().is_zero()

        def intersection(self: Any, other: Any) -> Any:
            r"""Return $D_1 \cdot D_2$."""
            return self.b(other)

        def self_intersection(self: Any) -> Any:
            r"""Return $D^2$."""
            return self.norm()

    class MorphismMethods:
        r"""Weil divisor group morphism methods."""


def install_weil_divisor_groups() -> None:
    r"""Register post-init hooks and installation for Weil divisor groups."""
    pass
