r"""Free modules on finite totally ordered sets."""

from collections.abc import Iterable
from typing import Any

from sage.rings.integer import Integer
from sage.categories.category_types import Category_over_base_ring
from sage.categories.morphism import SetMorphism
from sage.modules.free_module_element import vector
from sage.rings.integer import Integer as SageInteger
from sage.structure.element import ModuleElement
from sage.structure.parent import Parent
from sage.structure.richcmp import richcmp
from sage_lattice_category_spike.objects.cardinals import Cardinal

from sage_lattice_category_spike.objects.sets import Sets


def _finite_rank(generating_set: Any) -> Integer:
    size = generating_set.cardinality()
    if isinstance(size, Cardinal):
        assert size.is_finite(), "a finitely generated module has finite rank"
        return size.finite_value()
    return Integer(size)


class FinitelyGeneratedFreeModules(Category_over_base_ring):
    r"""Finite free modules whose framing set has a chosen total order."""

    @classmethod
    def _repr_object_names(cls) -> str:
        return "finitely generated framed free modules"

    def super_categories(self) -> list:
        return [
            FramedFreeModules(self.base_ring()),
            FinitelyGeneratedModules(self.base_ring()),
        ]

    class ParentMethods:
        def rank(self: Any) -> Any:
            r"""Return the cardinality of the finite generating set."""
            return self.generating_set().cardinality()

        def ngens(self: Any) -> Any:
            return self.generating_set().cardinality()

        def is_torsion(self: Any) -> bool:
            return self.is_zero()

        def Aut(self: Any) -> Any:
            cached = self.__dict__.get("_preamble_Aut")
            if cached is None:
                cached = ModuleAutomorphismGroup(self)
                self._preamble_Aut = cached
            return cached

        def subobject_on(self: Any, generators: Any) -> Any:
            gens = []
            for g in generators:
                if hasattr(g, "parent") and g.parent() is self:
                    gens.append(g)
                elif hasattr(self, "_from_coordinates"):
                    gens.append(self._from_coordinates(g))
                else:
                    gens.append(self(g))
            generators = tuple(gens)
            assert all(generator.parent() is self for generator in generators), (
                "a subobject is generated by elements of this module"
            )
            generators = _independent_generators(self, generators)
            generating_set = finite_ordered_set(tuple(generators))
            submodule = BasedFreeModule(self.base_ring(), generating_set)
            embedding = module_homset(submodule, self)(
                {
                    generator: generator
                    for generator in generating_set
                }
            )
            return Subobject(embedding)

        def submodule(self: Any, generators: Any, *args: Any, **kwargs: Any) -> Any:
            r"""Return the submodule generated by ``generators``."""
            return self.subobject_on(generators)

        def generator_matrix(self: Any) -> Any:
            r"""Return the matrix whose rows are the coordinates of this module's generators."""
            if hasattr(self, "structure_morphism"):
                elems = self.embedded_elements()
                target = self.structure_morphism().codomain()
                def _coords(v):
                    if hasattr(v, "_coordinates_"):
                        return list(v._coordinates_)
                    if hasattr(target, "coordinate_vector"):
                        return list(target.coordinate_vector(v))
                    return list(v)
                return matrix(self.base_ring(), [_coords(v) for v in elems])
            gens = list(self.module_generators()) if hasattr(self, "module_generators") else list(self.gens())
            if not gens:
                return matrix(self.base_ring(), 0, self.ngens())
            def _coords(v):
                if hasattr(v, "_coordinates_"):
                    return list(v._coordinates_)
                if hasattr(self, "coordinate_vector"):
                    return list(self.coordinate_vector(v))
                return list(v)
            return matrix(self.base_ring(), [_coords(v) for v in gens])

        def hom(self: Any, images: Any, codomain: Any = None) -> Any:
            r"""Construct the map specified on the finite generating set."""
            match images:
                case SetMorphism():
                    assert isinstance(images.codomain(), UnderlyingSet), (
                        "a generator morphism lands in the underlying set of "
                        "its module codomain"
                    )
                    target = images.codomain().structured_parent()
                    assignment = images
                case dict() if images:
                    target = next(iter(images.values())).parent()
                    assignment = images
                case dict():
                    assert codomain is not None, (
                        "the empty assignment requires an explicitly named codomain"
                    )
                    target = codomain
                    assignment = images
                case list() | tuple():
                    target, assignment = _finite_generator_assignment(
                        self,
                        images,
                        codomain,
                    )
                case _:
                    raise TypeError(
                        "a homomorphism is specified by a generator morphism, "
                        "a finite assignment, or an ordered list of images"
                    )
            return self.Hom(target)(assignment)


class BasedFreeModuleElement(ModuleElement):
    r"""An element represented in its parent's chosen ordered basis."""

    def __init__(self, parent: Any, coordinates: Any) -> None:
        ModuleElement.__init__(self, parent)
        self._coordinates_ = vector(parent.base_ring(), list(coordinates))
        assert len(self._coordinates_) == parent.ngens(), (
            f"{parent} has rank {parent.ngens()}, got "
            f"{len(self._coordinates_)} coordinates"
        )

    def _coordinates(self) -> Any:
        return self._coordinates_

    def coefficients(self) -> dict:
        return {
            element_of_S: coefficient
            for element_of_S, coefficient in zip(
                self.parent().generating_set(), self._coordinates_
            )
            if coefficient != 0
        }

    def underlying_set_element(self) -> Any:
        r"""Recover \(s\) when this element is the canonical generator \([s]\)."""
        nonzero = tuple(self.coefficients().items())
        assert len(nonzero) == 1, (
            "only an element in the image of the canonical generator morphism "
            "has one underlying element of S"
        )
        element_of_S, coefficient = nonzero[0]
        assert coefficient == self.parent().base_ring().one(), (
            "only an element in the image of the canonical generator morphism "
            "has one underlying element of S"
        )
        return element_of_S

    def _add_(self, other: Any) -> "BasedFreeModuleElement":
        return self.parent()._from_coordinates(
            self._coordinates_ + other._coordinates_
        )

    def _sub_(self, other: Any) -> "BasedFreeModuleElement":
        return self.parent()._from_coordinates(
            self._coordinates_ - other._coordinates_
        )

    def _neg_(self) -> "BasedFreeModuleElement":
        return self.parent()._from_coordinates(-self._coordinates_)

    def _lmul_(self, factor: Any) -> "BasedFreeModuleElement":
        return self.parent()._from_coordinates(
            self.parent().base_ring()(factor) * self._coordinates_
        )

    _rmul_ = _lmul_

    def _richcmp_(self, other: Any, op: int) -> bool:
        return richcmp(self._coordinates_, other._coordinates_, op)

    def __hash__(self) -> int:
        return hash(tuple(self._coordinates_))

    def __iter__(self):
        return iter(self._coordinates_)

    def _repr_(self) -> str:
        return repr(self._coordinates_)


class BasedFreeModule(FreeModuleOnSet):
    r"""The finite specialization of \(F_R(S)\) for a totally ordered \(S\)."""

    Element = BasedFreeModuleElement

    def __init__(self, base_ring: Any, generating_set: Any) -> None:
        match generating_set:
            case int() | SageInteger():
                assert generating_set >= 0, (
                    "the canonical finite framing has nonnegative cardinality"
                )
                generating_set = Sets.Δ[generating_set - 1]
            case Parent():
                pass
            case Iterable():
                generating_set = _as_set(generating_set)
            case _:
                raise TypeError(
                    "a generating set is a finite set, a finite iterable, or "
                    "a nonnegative cardinality"
                )
        if generating_set in Sets().Finite():
            generating_set = finite_ordered_set(generating_set)
        else:
            generating_set = _as_set(generating_set)
        FreeModuleOnSet.__init__(self, base_ring, generating_set)

    def _generator_element(self, element_of_S: Any) -> BasedFreeModuleElement:
        generating_set = self.__dict__.get("_generating_set")
        assert generating_set is not None, (
            "a framed free module stores its canonical generating set"
        )
        assert element_of_S in generating_set, (
            f"{element_of_S!r} is not in {generating_set}"
        )
        index = generating_set.index(element_of_S)
        return self._from_coordinates(
            [self.base_ring()(position == index) for position in range(self.ngens())]
        )

    def ngens(self) -> int:
        return _finite_rank(self.generating_set())

    def rank(self) -> Any:
        return self.generating_set().cardinality()

    def zero(self) -> BasedFreeModuleElement:
        return self._from_coordinates([self.base_ring().zero()] * self.ngens())

    def _from_coordinates(self, coordinates: Any) -> BasedFreeModuleElement:
        return self.element_class(self, coordinates)

    def _element_constructor_(self, value: Any) -> BasedFreeModuleElement:
        assert isinstance(value, BasedFreeModuleElement) and value.parent() is self, (
            f"{value} is not an element of {self}"
        )
        return value

    def __contains__(self, value: Any) -> bool:
        return isinstance(value, BasedFreeModuleElement) and value.parent() is self

    def __eq__(self, other: Any) -> bool:
        generating_set = self.__dict__.get("_generating_set")
        other_generating_set = getattr(other, "_generating_set", None)
        return (
            isinstance(other, BasedFreeModule)
            and self.base_ring() == other.base_ring()
            and generating_set is not None
            and other_generating_set is not None
            and tuple(generating_set) == tuple(other_generating_set)
        )

    def __hash__(self) -> int:
        generating_set = self.__dict__.get("_generating_set")
        assert generating_set is not None, (
            "a based free module stores its canonical generating set"
        )
        return hash(
            (
                type(self),
                self.base_ring(),
                tuple(generating_set),
            )
        )

    def _repr_(self) -> str:
        return (
            f"Free {self.base_ring()}-module on the ordered set "
            f"{self.generating_set()}"
        )

def Free_ZZ(generating_set: Any) -> FreeModuleOnSet:
    r"""Construct the free \(\mathbb Z\)-module on ``generating_set``."""
    return FreeModuleOn(ZZ, generating_set)
