{
  "name": "@dzack/jupyterlab-sage-syntax",
  "version": "0.1.0",
  "description": "Register Sage source files for CodeMirror syntax highlighting in JupyterLab.",
  "license": "BSD-3-Clause",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "sage",
    "codemirror"
  ],
  "files": [
    "lib/**/*",
    "package.json",
    "schema/**/*",
    "static/**/*",
    "style/**/*"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc -b && sage -python -m jupyter labextension build . && cp node_modules/tree-sitter-sage/tree-sitter-sage.wasm node_modules/web-tree-sitter/web-tree-sitter.wasm static/static/",
    "clean": "rimraf lib tsconfig.tsbuildinfo static",
    "test": "tsc -b && node --test lib/__tests__/*.test.js"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.10.0",
    "@jupyterlab/application": "^4.6.0",
    "@jupyterlab/apputils": "^4.6.0",
    "@jupyterlab/codemirror": "^4.6.0",
    "@jupyterlab/coreutils": "^6.6.2",
    "@lezer/highlight": "^1.2.3",
    "web-tree-sitter": "^0.26.11",
    "tree-sitter-sage": "github:dzackgarza/tree-sitter-sage"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.0.0-beta.1",
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.1",
    "jsdom": "^29.1.1",
    "rimraf": "~5.0.5",
    "typescript": "~5.9.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "static",
    "webpackConfig": "./webpack.config.js",
    "_build": {
      "load": "static/remoteEntry.272517a4a945f54e.js",
      "extension": "./extension",
      "style": "./style"
    }
  },
  "style": "style/index.css"
}
