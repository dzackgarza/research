// research#807.  Two explicit irreducible rational plane sextics all of whose
// singular points are double points, and whose ten double points are not ten
// distinct nodes.
//
//   Z8  : (y^2 - x^3 -  3x +  4)^2 +  8 (y^2 - x^3 +  3x -  2) = 0
//         singular points  A_15 at o = (0:1:0),  A_1 at (1,0),  A_1 at (0,0)
//   Z64 : (y^2 - x^3 + 15x - 22)^2 + 64 (y^2 - x^3 + 12x - 16) = 0
//         singular points  A_15 at o = (0:1:0),  A_1 at (2,0),  A_2 at (-3,0)
//
// Both are members of a pencil  w^2 + t z^3 q = 0  with  w = y^2 z - p(x,z)  the
// equation of a smooth cubic C_0 with flex o, and q = w + c (x - x0 z) z^2,
// p(x0) = 0, c = p'(x0).  Run:  Singular -q < coble_807-nonclassical-sextics.sing
LIB "sing.lib"; LIB "hnoether.lib"; LIB "classify.lib"; LIB "normal.lib"; LIB "absfact.lib";

proc report(string name, poly G, list affpts)
{
  // G is homogeneous in the basering 0,(x,y,z),dp
  "==", name;
  "degree:", deg(G);
  "genus of the projective curve:", genus(ideal(G));
  def S = absFactorize(G); setring S;
  "number of absolute factors:", size(absolute_factors[1]) - 1;
  "multiplicities (first entry belongs to the constant factor):", absolute_factors[2];
  setring R;
  "restriction to the line z = 0:", subst(G, z, 0);
  // the point o = (0:1:0), chart y = 1
  ring L = 0,(x,z),ds;
  map f = R, x, 1, z;
  poly g = f(G);
  "at o: Milnor number", milnor(g), " delta", delta(g);
  "at o: normal form"; classify(g);
  setring R;
  // affine singular points, chart z = 1
  int i;
  for (i = 1; i <= size(affpts); i++)
  {
    ring A = 0,(x,y),ds;
    map h = R, x + affpts[i][1], y + affpts[i][2], 1;
    poly g = h(G);
    "at (", affpts[i][1], ",", affpts[i][2], "): value", jet(g, 0), " Milnor number", milnor(g), " delta", delta(g);
    "normal form"; classify(g);
    setring R;
    kill A;
  }
}

ring R = 0,(x,y,z),dp;

// first pencil: p = x^3 + 3x - 4, x0 = 1, c = 6
poly w1 = y2z - x3 - 3xz2 + 4z3;
poly q1 = y2z - x3 + 3xz2 - 2z3;
"check q1 = w1 + 6 (x - z) z^2:", q1 - (w1 + 6*(x - z)*z^2);
ideal J1 = jacob(w1); J1 = J1, w1;
"C_0 smooth: dimension of the affine cone over its singular locus (0 means empty):", dim(std(J1));
poly Z8 = w1^2 + 8*z^3*q1;
list pts8 = list(list(1, 0), list(0, 0));
report("Z8", Z8, pts8);
poly Zgen = w1^2 + z^3*q1;
"== general member t = 1 of the first pencil: genus", genus(ideal(Zgen));

// second pencil: p = x^3 - 15x + 22, x0 = 2, c = -3
poly w2 = y2z - x3 + 15xz2 - 22z3;
poly q2 = y2z - x3 + 12xz2 - 16z3;
"check q2 = w2 - 3 (x - 2z) z^2:", q2 - (w2 - 3*(x - 2*z)*z^2);
ideal J2 = jacob(w2); J2 = J2, w2;
"C_0 smooth: dimension of the affine cone over its singular locus (0 means empty):", dim(std(J2));
poly Z64 = w2^2 + 64*z^3*q2;
list pts64 = list(list(2, 0), list(-3, 0));
report("Z64", Z64, pts64);
quit;
