assert g_star_Pic(H_Z_pullback) == Y_pullback.O(2)
assert f_star_Pic(g_star_Pic(H_Z_pullback)) == X_pullback.O(2, 0)
assert h_star_Pic(H_Z_pullback) == X_pullback.O(2, 0)

