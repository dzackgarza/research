    custom = getattr(
        group,
        '_projective_framework_latex_name',
        None,
    )
    if custom is not None:
        return str(custom)
    try:
        if group.is_cyclic():
            return r'C_{' + str(latex(group.order())) + r'}'
    except (AttributeError, NotImplementedError):
        pass
    return str(latex(group))


def _finite_action_latex(self):
