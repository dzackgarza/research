# Repo-scoped stubs; see lexicon/README.md.
#
# The realization of the lexicon noun ``OrderedSet`` (INVENTORY.md II.1): a
# finite set carrying a distinguished linear order, where the order IS the
# enumeration handed to the constructor (never a sort Sage performs). It is a
# finite enumerated set, so unlike a bare ``Set`` it can count and be ranked.
# Generic in its member type, and declaring the true ``Sets.ParentMethods``
# MRO edge so it satisfies the ``Set`` noun as well.
from collections.abc import Iterable, Iterator
from typing import Generic

from typing_extensions import TypeVar

from sage.categories.sets_cat import Sets
from sage.rings.integer import Integer
from sage.structure.element import Element
from sage.structure.parent import Parent

_E = TypeVar("_E", bound=Element, default=Element)

class TotallyOrderedFiniteSetElement(Element):
    def __lt__(self, other: TotallyOrderedFiniteSetElement) -> bool: ...
    def __le__(self, other: TotallyOrderedFiniteSetElement) -> bool: ...
    def __gt__(self, other: TotallyOrderedFiniteSetElement) -> bool: ...
    def __ge__(self, other: TotallyOrderedFiniteSetElement) -> bool: ...

class TotallyOrderedFiniteSet(Sets.ParentMethods[_E], Parent[_E], Generic[_E]):
    # The enumeration is the order; repeated members collapse to their first
    # position (UniqueRepresentation on the de-duplicated tuple).
    def __init__(self, elements: Iterable[_E], facade: bool = ...) -> None: ...
    def __iter__(self) -> Iterator[_E]: ...
    def __len__(self) -> int: ...
    def __contains__(self, x: object) -> bool: ...
    def cardinality(self) -> Integer: ...
    def list(self) -> list[_E]: ...
    def first(self) -> _E: ...
    def last(self) -> _E: ...
    # Position in the order, and its inverse.
    def rank(self, x: _E) -> Integer: ...
    def unrank(self, i: int | Integer) -> _E: ...
    # The order relation itself.
    def le(self, x: _E, y: _E) -> bool: ...
