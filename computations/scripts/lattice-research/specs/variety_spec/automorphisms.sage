# ============================================================================
# FIXTURE: AUTOMORPHISMS — SYMPLECTIC AND NON-SYMPLECTIC
#
# For a smooth projective variety X, an automorphism φ ∈ Aut(X) acts on the
# canonical bundle K_X = det Ω^n_X.  For K3 surfaces (K_X trivial, H^{2,0}
# generated by a single 2-form ω):
#
#   φ is SYMPLECTIC  (or holomorphic symplectic) if  φ^* ω = ω
#                    i.e. the induced action on H^{2,0}(X) ≅ CC is +1
#
#   φ is NON-SYMPLECTIC if  φ^* ω = ζ · ω  for some root of unity ζ ≠ 1
#
# For a finite automorphism φ of order n:
#   - Symplectic iff the character of φ on H^{2,0} is trivial
#   - Non-symplectic of order n iff φ^* ω = ζ_n · ω (primitive n-th root)
#
# The Enriques involution ι on a K3 surface X is the deck transformation of
# the 2:1 cover X → Y (Y Enriques).  It is non-symplectic of order 2:
#   ι^* ω = -ω.
#
# An automorphism is
#   φ.is_symplectic()        -- True iff φ^* acts as +1 on H^{2,0}
#   φ.is_nonsymplectic()     -- True iff φ^* acts as a nontrivial root of unity
#   φ.fixed_locus()          -- Fix(φ) ⊂ X as a subscheme
#   φ.trace_on_cohomology(k) -- Tr(φ^* | H^k(X))
#
# References:
#   Nikulin (1979) — finite automorphism groups of K3 surfaces
#   Mukai (1988)   — symplectic automorphisms and Mukai's list
#   Morrison–Nikulin — non-symplectic involutions of K3 surfaces
#   Sterk (1985) — the Enriques involution and Γ_En
# ============================================================================

P2 = PP^2(CC)
P3 = PP^3(CC)


# ============================================================================
# Section 1: Automorphisms of PP^1 — all are non-symplectic (no 2-form)
# ============================================================================
# PP^1 has no non-zero global 2-forms; the symplectic notion applies to
# surfaces (and higher), not curves.  We verify that automorphisms of PP^1
# do not satisfy is_symplectic() (not applicable) and note the involution.

inv_P1 = PP^1(CC).automorphism([0, 1, 1, 0])    # [s:t] ↦ [t:s], involution
assert inv_P1.order() == 2
assert not inv_P1.is_symplectic()                 # no symplectic form on PP^1
assert not inv_P1.is_nonsymplectic()              # not in the K3/Enriques sense


# ============================================================================
# Section 2: K3 surface — Enriques involution (non-symplectic of order 2)
# ============================================================================
# The Enriques involution ι: X → X is the deck transformation of X → Y
# where Y is an Enriques surface.  It acts as -1 on H^{2,0}(X), so:
#   ι^* ω = -ω  =>  is_nonsymplectic() and order 2.

Y   = EnriquesSurface(...)
f_k3 = Y.k3_cover()
X    = f_k3.domain()
iota = f_k3.deck_transformation()

assert iota.order() == 2
assert iota.is_nonsymplectic()
assert not iota.is_symplectic()
assert iota.trace_on_cohomology(2) == 22 - 2   # acts as -1 on H^{2,0}⊕H^{0,2}, +1 on H^{1,1}

# Fixed locus of a non-symplectic involution on a K3:
# For the Enriques involution: fixed locus is EMPTY (ι is free)
Fix_iota = iota.fixed_locus()
assert Fix_iota.is_empty()

# Quotient: X / ι ≅ Y (Enriques surface)
assert (X / iota).is_isomorphic_to(Y)


# ============================================================================
# Section 3: K3 surface — symplectic involutions
# ============================================================================
# A symplectic involution on a K3 surface X:
#   σ^* ω = ω,  σ of order 2.
# By Nikulin, Fix(σ) consists of exactly 8 isolated points.
# The quotient X / σ is a K3 surface with 8 A1-singularities.

# Kummer surface: K3 obtained by resolving T/ι where T is a complex torus and
# ι: T → T is x ↦ -x.  The involution ι on T is symplectic.
T2   = ComplexTorus.principally_polarized(2)
iota_T = T2.negation_automorphism()           # x ↦ -x

assert iota_T.order() == 2
assert iota_T.is_symplectic()
assert not iota_T.is_nonsymplectic()

Fix_T = iota_T.fixed_locus()
assert Fix_T.cardinality() == 16              # 2-torsion points of T

# The Kummer K3 is the resolution of T/ι
pi_Kum = T2.quotient(iota_T)
X_Kum  = pi_Kum.resolution_of_singularities()
assert X_Kum.is_k3()

# A symplectic involution on the Kummer K3 (coming from the torus involution)
sigma_Kum = X_Kum.induced_automorphism(iota_T)
assert sigma_Kum.is_symplectic()
assert sigma_Kum.fixed_locus().cardinality() == 8   # Nikulin's 8 points


# ============================================================================
# Section 4: Non-symplectic automorphisms of prime order p
# ============================================================================
# For a K3 surface X with non-symplectic automorphism φ of prime order p:
#   φ^* ω = ζ_p · ω   (ζ_p a primitive p-th root of unity)
#   Lefschetz fixed-point formula constrains Fix(φ).
#
# Nikulin's classification: p ∈ {2, 3, 5, 7, 11, 13, 17, 19} for K3 surfaces.

# Order-3 non-symplectic automorphism
R3.<x,y,z> = PolynomialRing(CC, 3)
R4.<u,v,s,w> = PolynomialRing(CC, 4)

# Fermat quartic K3: x^4+y^4+z^4+w^4; φ: [x:y:z:w] ↦ [x:iy:z:w] (order 4)
# Order-3: [x:y:z:w] ↦ [x:ζ_3·y:z:w]
X_q  = Variety(u^4 + v^4 + s^4 + w^4)
phi3 = X_q.automorphism(diagonal_matrix([1, CyclotomicField(3).gen(), 1, 1]))

assert phi3.order() == 3
assert phi3.is_nonsymplectic()
assert not phi3.is_symplectic()

# Fixed locus of order-3 non-symplectic: a curve (Lefschetz fixed-point theorem)
Fix3 = phi3.fixed_locus()
assert Fix3.dimension() == 1   # curve, not isolated points

# Order-2 non-symplectic involution on the Fermat quartic:
# [x:y:z:w] ↦ [x:y:z:-w]  (reflection in last coordinate)
phi2 = X_q.automorphism(diagonal_matrix([1, 1, 1, -1]))

assert phi2.order() == 2
assert phi2.is_nonsymplectic()
assert not phi2.is_symplectic()

Fix2 = phi2.fixed_locus()
assert Fix2.dimension() == 1   # non-symplectic involution fixes a curve

# Contrast: a symplectic order-2 automorphism fixes 8 points (not a curve)
phi2_symp = X_q.symplectic_involution()  # a symplectic involution of X_q
assert phi2_symp.is_symplectic()
assert phi2_symp.fixed_locus().dimension() == 0
assert phi2_symp.fixed_locus().cardinality() == 8


# ============================================================================
# Section 5: Action on cohomology and Lefschetz trace formula
# ============================================================================
# For φ: X → X automorphism of X:
#   Σ_k (-1)^k Tr(φ^* | H^k(X)) = χ_top(Fix(φ))   [Lefschetz]
#
# For K3: H^0 = CC, H^1 = 0, H^2 has dim 22, H^3 = 0, H^4 = CC.

# Non-symplectic involution ι of the K3 (Enriques-type):
# Acts on H^0 as +1, on H^2 as  (sign on H^{2,0}: -1, fixes H^{1,1})
# Fix(ι) is empty, so Lefschetz number = 0
Lef_iota = sum((-1)^k * iota.trace_on_cohomology(k) for k in range(5))
assert Lef_iota == iota.fixed_locus().topological_euler_characteristic()
assert Lef_iota == 0   # ι free

# Symplectic involution σ: Fix has 8 points, χ = 8
sigma  = X_Kum.induced_automorphism(iota_T)   # from Section 3
Lef_s  = sum((-1)^k * sigma.trace_on_cohomology(k) for k in range(5))
assert Lef_s == sigma.fixed_locus().topological_euler_characteristic()
assert Lef_s == 8   # 8 isolated fixed points


# ============================================================================
# Section 6: Automorphism groups
# ============================================================================
# For "generic" K3 surfaces (Picard rank 1), Aut(X) = {±1} or trivial.
# For very special K3 surfaces the automorphism group can be infinite.

# Fermat quartic has finite automorphism group (contains the symmetric group S_4
# permuting coordinates and cyclic groups acting on each coordinate)
Aut_Xq = X_q.automorphism_group()
assert Aut_Xq.order() > 1
assert Aut_Xq.is_finite()

# Symplectic subgroup (Mukai's theorem: embeds in the Mathieu group M_20 or M_24)
Aut_symp = Aut_Xq.symplectic_subgroup()
assert all(phi.is_symplectic() for phi in Aut_symp)
assert all(not phi.is_nonsymplectic() for phi in Aut_symp if phi.order() > 1)

# Non-symplectic elements
Aut_nonsymp = [phi for phi in Aut_Xq if phi.is_nonsymplectic()]
assert all(not phi.is_symplectic() for phi in Aut_nonsymp)
