L = Lattice.A(4)
assert L in RootLattices # Cateegory promotion Lattice -> RootLattice
assert L.span(L.root_system()).is_isometric_to(L) # Root system = set of simple roots, which can be used to span a sublattice
assert L.root_system().inclusion().index() == 1 # Root lattices := lattices spanned by their root systems
assert {x for x in L.root_system()} == {x for x in L.gens()} # Generators are roots.

G = L.coxeter_diagram() # Defined for any RootLattice
P = G.subdiagram_poset()
assert P in Posets
assert {G_i for G_i in P} == {Lattice.A(n).coxeter_diagram() for n in [0,1,2,3,4]} # A_n has subdiagrams of the form A_{k} for all 0 <= k <= n, some with multiplicity

# A_4: (0) -- (1) -- (2) -- (3) 
# Each node has a self-loop/weight of -2 and edges of weight 1

assert P.max() == {G} # The set of maximal elements
assert P.min() == {G.subdiagram({})} # The set of minimal elements
assert G.subdiagram({0}) <= G.subdiagram({0,1})
assert G.subdiagram({0,1}) <= G.subdiagram({0,1,2})
assert G.subdiagram({0,1,2}).is_connected() and not G.subdiagram({0,2,3}).is_connected()
assert G.adjacency_matrix(weighted=False) == matrix(ZZ, 4, [
	[1,1,0,0],
	[1,1,1,0],
	[0,1,1,1],
	[0,0,1,1]
]) # TODO: check
# TODO: assert on G.adjacency_matrix(), which includes weights

