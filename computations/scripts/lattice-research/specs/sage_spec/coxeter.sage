# TODO: assert G.parabolic_subdiagrams().max() == .... # Set of all maximal parabolic subdiagrams
# TODO: assert G.elliptic_subdiagrams() == ... 
# TODO: assert G.elliptic_subdiaigrams().max() == ...
# TODO: 
