# TODO: assert folding symmetries

G.<n1, n2, n3, n4> = L.coxeter_diagram() # Allow named nodes
Aut_G = G.Aut()
assert Aut_G.is_isomorphic_to(ZZ/2)

fold_4 == G.Hom(G).from_dict({
	n1: n4,
	n2: n3,
	n3: n2,
	n4: n1
})
# Fold about central vertical line of symmetry
assert fold_4.cyclic_subgroup() == Aut_G
assert Aut_G.gens() == (fold_4,)

R.<r1, r2, r3, r4> = L.root_system() # Allow named simple roots
assert R in RootSystems # Objects: root systems \Phi
assert R.span() == L
assert all( r_i.reflection()(r_j) in R for r_i in R for r_j in R) # \Phi is closed under reflections in simple roots
assert all( r_i.reflection() in L.base_change(QQ).O() ) # Reflections are always rational isometries
assert all( r_i.reflection() in L.O() ) # But reflections in roots are always integral isometries, by definition.
assert fold_4.order() == 2


root_fold_4 = R.Aut().from_dict({
	r1: r4,
	r2: r3,
	r3: r2,
	r4: r1
})

Aut_G.element_from_root_morphism(root_fold_4) == fold_4 # Any morphism of root systems induces a morphism of diagrams
assert root_fold_4.diagram_morphism() == fold_4 # Convenience
assert L.O() == L.W()
assert L.W() == L.O().subgroup_generated_by(ri.reflection() for ri in R.gens())

