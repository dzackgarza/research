# 	assert P.parabolic_subdiagrams().max() / Aut_G == ... 
# 	assert P.elliptic_subdiagrams() / Aut_G == ...

r1, r2, r3, r4 = L.gens()
assert all(v.is_root() for v in L.gens())
H1, H2, H3, H4 = [r.orthogonal_hyerplane() for r in L.gens()]
assert H1.angle_to(H2) == cos(pi/3)
assert H1.angle_to(H3) == cos(pi/2)
assert H3.angle_to(H4) == cos(pi/3)
