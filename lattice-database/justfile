# lattice-database — a catalogue of lattices, one Markdown record per lattice, and the site built from it.
#
# Every recipe calls the `latticedb` command line (src/latticedb/cli.py), which owns the
# records, their validation, the build and the deployment. The QC gates of the research
# repository cover this directory; this file adds no gate of its own.

# List available recipes
default:
    @just --list

# Write the record of a new lattice from its Gram tensor: `just new --gram '[[2,1],[1,2]]' --name A2 --latex A_2 --source '...'`
new *ARGS:
    uv run latticedb new {{ARGS}}

# Write the record of an entry of the Catalogue of Lattices: `just nebe-sloane LAMBDA10 --name Lambda10 --latex '\Lambda_{10}' --family laminated`
nebe-sloane ENTRY *ARGS:
    uv run latticedb nebe-sloane {{ENTRY}} {{ARGS}}

# Check a morphism of lattices and append it to morphisms/<S>-<T>.md: `just morphism 0016 0016 --name exchange --matrix '[[0,1],[1,0]]'`
morphism SOURCE TARGET *ARGS:
    uv run latticedb morphism {{SOURCE}} {{TARGET}} {{ARGS}}

# Compute again, in every record, each field that the Gram tensor determines, and write the records that change
derive:
    uv run latticedb derive

# Validate every record and build the site into _site/
build:
    uv run latticedb build

# Build the site and serve it at http://lattice-database.localhost/
deploy:
    uv run latticedb deploy

# Print the tag for the next new record
tag:
    uv run latticedb next-tag

# Run the tests of the schema and of the build
test:
    uv run pytest
