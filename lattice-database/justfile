# lattice-database — a catalogue of lattices, one Markdown record per lattice, and the site built from it.
#
# Each recipe runs one lattice database workflow.

# List available recipes
default:
    @just --list

# Run the lattice database in the repository's Sage Python, with both source
# trees visible.  The database consumes the preamble's lattice mathematics, so
# plain CPython is not a supported runtime.
[private]
_latticedb *ARGS:
    PYTHONPATH="../src:src" "$(just -f ~/ai-review-ci/justfiles/sage.just -d .. _sage-python)" -m latticedb {{ARGS}}

# Author a lattice card from its Gram tensor: `just new --gram '[[2,1],[1,2]]' --name A2 --latex A_2`
new *ARGS:
    just _latticedb new {{ARGS}}

# Author a morphism in morphisms/<S>-<T>.md: `just morphism 0016 0016 --name exchange --matrix '[[0,1],[1,0]]'`
morphism SOURCE TARGET *ARGS:
    just _latticedb morphism {{SOURCE}} {{TARGET}} {{ARGS}}

# Convert stored source rows into permanent lattice cards
seed *ARGS:
    just _latticedb seed {{ARGS}}

# Compute and store derived fields on existing cards
enrich *ARGS:
    just _latticedb enrich {{ARGS}}

# CI certification: compute uncertified values, replace disagreements, and write certificate hashes
certify *ARGS:
    just _latticedb certify {{ARGS}}

# Report mathematical errors in the cards and relations
verify:
    just _latticedb verify

# Build the site into _site/
build:
    just _latticedb build

# Build the site and serve it at http://lattice-database.localhost/
deploy:
    just _latticedb deploy

# Print the tag for the next new record
tag:
    just _latticedb next-tag

# Run the fast tests of the code: schema, record commands and site logic on fixtures and single specimens, never the full corpus
test:
    PYTHONPATH="../src:src" "$(just -f ~/ai-review-ci/justfiles/sage.just -d .. _sage-python)" -m pytest tests --ignore=tests/validation --ignore=tests/source_intake

# Run full-corpus mathematical validation and the build
test-validation:
    PYTHONPATH="../src:src" "$(just -f ~/ai-review-ci/justfiles/sage.just -d .. _sage-python)" -m pytest tests/validation

# Exercise archived-source importers and source-to-card collation; provenance only, not mathematical validation
test-source-intake:
    PYTHONPATH="../src:src" "$(just -f ~/ai-review-ci/justfiles/sage.just -d .. _sage-python)" -m pytest tests/source_intake

# List the tags that share a Gram tensor
duplicates:
    just _latticedb duplicates
