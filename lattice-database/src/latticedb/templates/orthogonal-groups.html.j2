{% extends "base.html.j2" %}
{% block title %}O(p, q) analysis · {% endblock %}
{% block main %}
<header class="page-heading">
  <p class="kicker">Groups</p>
  <h1>\(O(p, q)\) analysis</h1>
  <p class="lede">
    The orthogonal group \(O(p, q)\) of a real quadratic space of signature
    \((p, q)\), for \(0 \leq p \leq q \leq 24\). \(O(p, q) \cong O(q, p)\), so
    the group is indexed by the unordered pair \(\{p, q\}\), and the table is
    its upper triangle. A nondegenerate lattice \(L\) of signature \((p, q)\)
    has
    \(O(L) \hookrightarrow O(L \otimes_{\mathbb{Z}} \mathbb{R}) \cong O(p, q)\)
    by base change, an arithmetic subgroup; every nondegenerate lattice of that
    signature lies under it.
  </p>
</header>

<section aria-labelledby="grid">
  <h2 id="grid">Groups \(O(p, q)\), \(0 \leq p \leq q \leq 24\)</h2>
  <p class="form-note">
    Each cell gives the number of lattices of the catalogue whose signature is
    \((p, q)\) or \((q, p)\), and links them in the
    <a href="{{ root }}database.html">database</a>; a cell marked
    &#183; is a group \(O(p, q)\) that no lattice realizes over
    \(\mathbb{Z}\).
  </p>
  <div class="table-scroll">
    <table class="member-table orthogonal-table">
      <thead>
        <tr>
          <th scope="col" class="orthogonal-corner">\(p \backslash q\)</th>
          {% for q in columns %}<th scope="col" class="numeric">{{ q }}</th>{% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for p, cells in rows %}
        <tr>
          <th scope="row" class="numeric">{{ p }}</th>
          {% for q, count in cells %}
          {% if count is none %}<td class="orthogonal-cell orthogonal-blank"></td>
          {% elif count %}<td class="orthogonal-cell"><a class="orthogonal-count" href="{{ root }}database.html?signature={{ p }},{{ q }}{% if p != q %}&amp;signature={{ q }},{{ p }}{% endif %}" title="Lattices of signature \(({{ p }}, {{ q }})\){% if p != q %} and \(({{ q }}, {{ p }})\){% endif %}">{{ count }}</a></td>
          {% else %}<td class="orthogonal-cell"><span class="orthogonal-empty" title="\(O({{ p }}, {{ q }})\): no lattice of this signature">&middot;</span></td>{% endif %}
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
