{% extends "base.html.j2" %}
{% block title %}{{ file.source }} to {{ file.target }} · {% endblock %}
{% block main %}
<article>
  <header class="page-heading">
    <p class="kicker">Morphisms <a class="tag" href="{{ root }}tag/{{ file.source }}.html">{{ file.source }}</a> \(\to\) <a class="tag" href="{{ root }}tag/{{ file.target }}.html">{{ file.target }}</a></p>
    <h1>\({{ source.latex }} \to {{ target.latex }}\)</h1>
    <p class="lede">
      Each matrix is in the bases of the two records: column \(j\) lists the coordinates of the image of \(e_j\). The build checks that
      \(M^{\top} G_T M = G_S\), so each map preserves the forms, and that the lines of each matrix cut orthogonal summands.
    </p>
  </header>

  {% if prose | trim %}
  <section aria-labelledby="notes">
    <h2 id="notes">Notes</h2>
    <div class="prose">{{ prose }}</div>
  </section>
  {% endif %}

  {% for morphism, tex, text in morphisms %}
  <section aria-labelledby="morphism-{{ loop.index }}">
    <h2 id="morphism-{{ loop.index }}">{{ morphism.name | inline_markup }}</h2>
    {% if morphism.description %}<p>{{ morphism.description | inline_markup }}</p>{% endif %}
    <div class="table-scroll">\[{{ tex }}\]</div>
    <div class="copy-block">
      <pre id="matrix-{{ loop.index }}">{{ text }}</pre>
      <button type="button" data-copy="matrix-{{ loop.index }}">Copy</button>
    </div>
  </section>
  {% endfor %}

  <section aria-labelledby="record">
    <h2 id="record">Record</h2>
    <p><code>morphisms/{{ file.source }}-{{ file.target }}.md</code></p>
  </section>
</article>
{% endblock %}
