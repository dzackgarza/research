{% extends "base.html.j2" %}
{% block title %}{{ geometric.name }} · {% endblock %}
{% block main %}
<article>
  <header class="page-heading">
    <p class="kicker">Geometric object</p>
    <h1>{{ geometric.name }}</h1>
    <p class="lede">Complex dimension {{ geometric.dimension }}.</p>
  </header>

  <section aria-labelledby="hodge-diamond">
    <h2 id="hodge-diamond">Hodge diamond</h2>
    <p>The entries are (h^{p,q} = \dim_{\mathbb C} H^q(X, \Omega_X^p)). Row (k) has (p+q=k), with (p) increasing from left to right.</p>
    <div class="hodge-diamond" aria-label="Hodge diamond">
      {% for row in rows %}
      <div class="hodge-row">
        {% for value in row %}<span>{{ value }}</span>{% endfor %}
      </div>
      {% endfor %}
    </div>
  </section>

  {% if geometric.cohomology_lattices %}
  <section aria-labelledby="cohomology-lattices">
    <h2 id="cohomology-lattices">Cohomology lattices</h2>
    <ul>
      {% for link in geometric.cohomology_lattices %}
      <li>
        (H^{ {{- link.degree -}} }(X;\mathbb Z)/\mathrm{tors}), with {{ link.pairing }}:
        <a href="{{ root }}tag/{{ link.tag }}.html">\({{ lattices[link.tag].latex }}{% if link.scale != 1 %}({{ link.scale }}){% endif %}\)</a>.
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section aria-labelledby="notes">
    <h2 id="notes">Notes</h2>
    {{ prose }}
  </section>

  {% if geometric.references %}
  <section aria-labelledby="references">
    <h2 id="references">References</h2>
    <ul>{% for reference in geometric.references %}<li>{% if reference.url %}<a href="{{ reference.url }}">{{ reference.citation }}</a>{% else %}{{ reference.citation }}{% endif %}</li>{% endfor %}</ul>
  </section>
  {% endif %}
</article>
{% endblock %}
