{% extends "base.html.j2" %}
{% block title %}{{ geometric.name }} · {% endblock %}
{% block main %}
<article>
  <header class="page-heading">
    <p class="kicker">Smooth projective complex variety</p>
    <h1>{{ geometric.name }}</h1>
    <p class="lede">Complex dimension {{ geometric.dimension }}.</p>
    {% if geometric.analytic_space %}<p>Analytic space: <a href="{{ root }}geometric-objects/{{ geometric.analytic_space }}.html">{{ geometric.analytic_space }}</a>.</p>{% endif %}
    {% if geometric.family %}<p><a href="{{ root }}geometric-families/{{ geometric.family }}.html">{{ families[geometric.family].name }}</a>, {{ families[geometric.family].parameter }} = {{ geometric.family_parameter }}.</p>{% endif %}
  </header>

  <section aria-labelledby="hodge-data">
    <h2 id="hodge-data">Stored Hodge numbers</h2>
    <p>The card stores the nonzero values <i>h</i><sup>p,q</sup> directly.</p>
    <div class="table-scroll"><table class="member-table"><thead><tr><th><i>p</i></th><th><i>q</i></th><th><i>h</i><sup>p,q</sup></th></tr></thead><tbody>
      {% for term in geometric.hodge_poincare %}<tr><td>{{ term.p }}</td><td>{{ term.q }}</td><td>{{ term.coefficient }}</td></tr>{% endfor %}
    </tbody></table></div>
    {% if geometric.symmetry_group %}<p>Symmetry group: {{ geometric.symmetry_group }}.</p>{% endif %}
  </section>

  <section aria-labelledby="numerical-invariants">
    <h2 id="numerical-invariants">Numerical invariants</h2>
    {% if geometric.local_deformation_dimension is not none %}<p>Dimension of the local deformation space: {{ geometric.local_deformation_dimension }}.</p>{% endif %}
    {% if geometric.chern_numbers %}
    <h3>Chern numbers</h3>
    <ul>
      {% for number in geometric.chern_numbers %}
      <li>∫{% for index in number.indices %}<i>c</i><sub>{{ index }}</sub>{% endfor %} = {{ number.value }}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </section>

  {% if geometric.cohomology_lattices %}
  <section aria-labelledby="cohomology-lattices">
    <h2 id="cohomology-lattices">Cohomology lattices</h2>
    <ul>
      {% for link in geometric.cohomology_lattices %}
      <li>
        H<sup>{{ link.degree }}</sup>(X; ℤ)/tors, with {{ link.pairing }}:
        <a href="{{ root }}tag/{{ link.tag }}.html">{{ lattices[link.tag].name }}{% if link.scale != 1 %}({{ link.scale }}){% endif %}</a>.
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  <section aria-labelledby="notes">
    <h2 id="notes">Notes</h2>
    {{ prose }}
  </section>

</article>
{% endblock %}
