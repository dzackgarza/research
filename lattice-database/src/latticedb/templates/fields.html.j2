{% extends "base.html.j2" %}
{% block title %}Fields · {% endblock %}
{% block main %}
<header class="page-heading">
  <h1>Fields</h1>
  <p class="lede">
    A record is the YAML front matter of <code>lattices/&lt;TAG&gt;.md</code>. The build checks each declaration against the
    components of the Gram tensor, and it rejects a record that is not well defined. An invariant that exists only under a
    hypothesis is in the block for that hypothesis, and a block on a lattice that does not satisfy the hypothesis is an error.
  </p>
</header>
{% for heading, key, description, model_fields in models %}
<section aria-labelledby="fields-{{ loop.index }}">
  <h2 id="fields-{{ loop.index }}">{{ heading }}{% if key %} <code>{{ key }}</code>{% endif %}</h2>
  {% if description %}<p>{{ description | inline_markup }}</p>{% endif %}
  <div class="table-scroll">
    <table class="field-table">
      <thead><tr><th scope="col">Field</th><th scope="col">Required</th><th scope="col">Meaning</th></tr></thead>
      <tbody>
        {% for name, field in model_fields %}
        <tr>
          <th scope="row"><code>{{ name }}</code></th>
          <td class="required">{{ "yes" if field.is_required() else "no" }}</td>
          <td>{{ field.description | inline_markup }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endfor %}
<section aria-labelledby="properties">
  <h2 id="properties">Properties</h2>
  <p>The build derives the properties of a lattice from its record. The database page filters by them, and a collection page can select by them.</p>
  <div class="table-scroll">
    <table class="field-table">
      <thead><tr><th scope="col">Property</th><th scope="col">Meaning</th></tr></thead>
      <tbody>
        {% for label, meaning in property_meanings.items() %}
        <tr>
          <th scope="row">{{ label }}</th>
          <td>{{ meaning | inline_markup }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
<section aria-labelledby="families">
  <h2 id="families">Families</h2>
  <p>A record names its families in <code>families</code>. <code>families.yaml</code> lists every family with one line of its meaning, and the build rejects a record that names a family not listed there.</p>
  <div class="table-scroll">
    <table class="field-table">
      <thead><tr><th scope="col">Family</th><th scope="col">Lattices</th><th scope="col">Meaning</th></tr></thead>
      <tbody>
        {% for family, meaning in families.items() %}
        <tr>
          <th scope="row"><code>{{ family }}</code></th>
          <td><a href="{{ root }}database.html?family={{ family }}">{{ family_counts[family] }}</a></td>
          <td>{{ meaning | inline_markup }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endblock %}
