{% extends "base.html.j2" %}
{% block title %}Database · {% endblock %}
{% block layout %} page-wide{% endblock %}
{% block head %}
  <link rel="stylesheet" href="https://cdn.datatables.net/2.3.8/css/dataTables.dataTables.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/searchpanes/2.3.5/css/searchPanes.dataTables.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/select/3.1.3/css/select.dataTables.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/datetime/1.6.0/css/dataTables.dateTime.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/searchbuilder/1.8.4/css/searchBuilder.dataTables.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/buttons/3.2.5/css/buttons.dataTables.min.css">
  <link rel="stylesheet" href="{{ root }}assets/database.css">
  <script defer src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script defer src="https://cdn.datatables.net/2.3.8/js/dataTables.min.js"></script>
  <script defer src="https://cdn.datatables.net/select/3.1.3/js/dataTables.select.min.js"></script>
  <script defer src="https://cdn.datatables.net/select/3.1.3/js/select.dataTables.min.js"></script>
  <script defer src="https://cdn.datatables.net/searchpanes/2.3.5/js/dataTables.searchPanes.min.js"></script>
  <script defer src="https://cdn.datatables.net/searchpanes/2.3.5/js/searchPanes.dataTables.min.js"></script>
  <script defer src="https://cdn.datatables.net/datetime/1.6.0/js/dataTables.dateTime.min.js"></script>
  <script defer src="https://cdn.datatables.net/searchbuilder/1.8.4/js/dataTables.searchBuilder.min.js"></script>
  <script defer src="https://cdn.datatables.net/searchbuilder/1.8.4/js/searchBuilder.dataTables.min.js"></script>
  <script defer src="https://cdn.datatables.net/buttons/3.2.5/js/dataTables.buttons.min.js"></script>
  <script defer src="https://cdn.datatables.net/buttons/3.2.5/js/buttons.dataTables.min.js"></script>
  <script defer src="https://cdn.datatables.net/buttons/3.2.5/js/buttons.colVis.min.js"></script>
  <script defer src="https://cdn.datatables.net/buttons/3.2.5/js/buttons.html5.min.js"></script>
  <script defer src="{{ root }}assets/database.js"></script>
{% endblock %}
{% block main %}
<header class="page-heading">
  <h1>Database</h1>
  <p class="lede">
    All {{ total }} records as one table. The panes filter by rank, definiteness, property and family.
    The condition builder makes a query on any column, such as \(n_- = 1\) and determinant \(> -8\).
    The minimum, the kissing number, the order of the isometry group and the types of \(\Phi_{\{\pm 2\}}(L)\) and \(\Phi(L)\) are recorded for definite lattices only.
    \(\mathbb{Z}\Phi(L)\) is the sublattice that the roots of \(L\) generate; <a href="{{ root }}collection/root-lattices.html">Root lattices</a> defines it.
    <a href="{{ root }}fields.html">Fields</a> defines each column and each property.
  </p>
</header>
<table id="lattice-table" class="display compact" style="width: 100%">
  <thead>
    <tr>
      <th>Tag</th>
      <th>Lattice</th>
      <th>Rank</th>
      <th>Signature</th>
      <th>Determinant</th>
      <th>Definiteness</th>
      <th>Properties</th>
      <th>Discriminant group</th>
      <th>Minimum</th>
      <th>Kissing number</th>
      <th>Isometry group order</th>
      <th>Type of Φ<sub>{±2}</sub>(L) (definite)</th>
      <th>Genus symbol</th>
      <th>Families</th>
      <th>Other names</th>
      <th>n₊</th>
      <th>n₋</th>
      <th>Type of Φ(L) (definite)</th>
      <th>ℤΦ(L)</th>
      <th>[L : ℤΦ(L)], when finite</th>
      <th>Rank of ℤΦ(L)</th>
      <th>Maximum of P(L)</th>
    </tr>
  </thead>
</table>
<noscript><p>The database needs JavaScript. The <a href="{{ root }}tags.html">tag index</a> lists every lattice without it.</p></noscript>
{% endblock %}
