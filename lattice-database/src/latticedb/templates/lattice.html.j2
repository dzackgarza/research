{% extends "base.html.j2" %}
{% block title %}{{ lattice.name }} · {% endblock %}
{% from "macros.html.j2" import theory with context %}
{% macro yes_no(value) %}{{ "yes" if value else "no" }}{% endmacro %}
{% macro declared() %}<a class="declared" href="{{ root }}theory/records.html#declared" title="Not computed here; the notes cite its source.">declared</a>{% endmacro %}
{% block main %}
<article>
  <header class="page-heading">
    <p class="kicker">Tag <span class="tag">{{ lattice.tag }}</span></p>
    <h1>\({{ lattice.latex }}\)</h1>
    <p class="names">{{ lattice.name }}{% for alias in lattice.aliases %}<span class="separator">·</span>{{ alias }}{% endfor %}</p>
    <ul class="chips" aria-label="Properties and families">
      <li><a href="{{ root }}database.html?definiteness={{ definiteness_label[lattice.definiteness] | urlencode }}">{{ definiteness_label[lattice.definiteness] }}</a></li>
      {% for property in properties(lattice) %}
      <li><a href="{{ root }}database.html?property={{ property | urlencode }}">{{ property }}</a></li>
      {% endfor %}
      {% for family in lattice.families %}
      <li class="family"><a href="{{ root }}database.html?family={{ family | urlencode }}" title="{{ families[family] }}">{{ family }}</a></li>
      {% endfor %}
    </ul>
  </header>

  <section aria-labelledby="invariants">
    <h2 id="invariants">Invariants</h2>
    <table class="facts">
      <tbody>
        <tr><th scope="row">Rank</th><td>{{ lattice.rank }}</td></tr>
        <tr><th scope="row">{{ theory("lattices", "signature", "Signature") }} \((n_+, n_-)\)</th><td>({{ lattice.signature[0] }}, {{ lattice.signature[1] }})</td></tr>
        {% if lattice.nullity %}
        <tr><th scope="row">Rank of the {{ theory("lattices", "degenerate", "radical") }}</th><td>{{ lattice.nullity }}</td></tr>
        {% endif %}
        <tr><th scope="row">{{ theory("lattices", "signature", "Determinant") }}</th><td>\({{ rational_tex(lattice.determinant) }}\)</td></tr>
      </tbody>
    </table>
  </section>

  <section aria-labelledby="gram-tensor">
    <h2 id="gram-tensor">Gram tensor</h2>
    <p>The components \(b(e_i, e_j)\) of the {{ theory("lattices", "gram-tensor", "Gram tensor") }} \(b\) in the {{ theory("lattices", "gram-tensor", "chosen basis") }} \({{ block_tex(range(1, lattice.rank + 1) | list) }}\).</p>
    {% if blocks | length > 1 %}
    <p>In this basis, \(L = {}\){% for block in blocks %}\(\mathbb{Z}\{ {{- block_tex(block) -}} \}\){% if not loop.last %} \(\oplus\) {% endif %}{% endfor %}, an {{ theory("lattices", "orthogonal-sums", "orthogonal sum") }}.</p>
    {% endif %}
    <div class="table-scroll">
      <table class="components">
        <thead>
          <tr><td></td>{% for j in range(1, lattice.rank + 1) %}<th scope="col">\(e_{ {{- j -}} }\)</th>{% endfor %}</tr>
        </thead>
        <tbody>
          {% for components_row in lattice.gram_tensor %}
          <tr><th scope="row">\(e_{ {{- loop.index -}} }\)</th>{% for value in components_row %}<td{% if value == 0 %} class="zero"{% endif %}>{{ value }}</td>{% endfor %}</tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="copy-block">
      <pre id="components-text">{{ components_text }}</pre>
      <button type="button" data-copy="components-text">Copy</button>
    </div>
  </section>

  {% if lattice.integral %}
  <section aria-labelledby="integral">
    <h2 id="integral">Integral lattice</h2>
    <table class="facts">
      <tbody>
        <tr><th scope="row">{{ theory("lattices", "integral", "Parity") }}</th><td>{{ lattice.integral.parity }}</td></tr>
        {% if lattice.integral.discriminant_group is not none %}
        <tr><th scope="row">{{ theory("discriminant-forms", "discriminant-group", "Discriminant group") }}</th><td>\({{ group_tex(lattice.integral.discriminant_group) }}\)</td></tr>
        <tr><th scope="row">{{ theory("discriminant-forms", "unimodular", "Unimodular") }}</th><td>{{ yes_no(lattice.is_unimodular) }}</td></tr>
        <tr><th scope="row">{{ theory("overlattices", "overlattices", "Integral overlattices") }} \(L \subseteq M \subseteq L^*\)</th><td>{% if lattice.integral.overlattice_count is not none %}{{ lattice.integral.overlattice_count }}{% else %}{{ theory("records", "not-decided", "not decided") }}{% endif %}</td></tr>
        {% endif %}
        {% if lattice.integral.delta is not none %}
        <tr><th scope="row">{{ theory("discriminant-forms", "two-elementary", "Nikulin invariants") }} \((r, a, \delta)\)</th><td>\(({{ lattice.rank }}, {{ lattice.integral.discriminant_group | length }}, {{ lattice.integral.delta }})\)</td></tr>
        {% endif %}
        {% if lattice.integral.genus_symbol %}
        <tr><th scope="row">{{ theory("overlattices", "genus-symbol", "Genus symbol") }}</th><td>\({{ genus_tex(lattice.integral.genus_symbol) }}\)</td></tr>
        {% endif %}
        {% if lattice.integral.genus_class_count is not none %}
        <tr><th scope="row">{{ theory("overlattices", "class-number", "Class number of the genus") }}</th><td>{{ lattice.integral.genus_class_count }}</td></tr>
        {% endif %}
        {% if lattice.integral.hyperbolic_index is not none or hyperbolic_bound is not none %}
        <tr><th scope="row">{{ theory("overlattices", "hyperbolic-index", "Hyperbolic index") }} \(\max\{n : L \cong U^n \oplus L'\}\)</th><td>{% if lattice.integral.hyperbolic_index is not none %}{{ lattice.integral.hyperbolic_index }}{% else %}\(\geq {{ hyperbolic_bound }}\), by an embedding of \(U^{ {{- hyperbolic_bound -}} }\) in the morphism files{% endif %}</td></tr>
        {% endif %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {% if lattice.definite %}
  <section aria-labelledby="definite">
    <h2 id="definite">Definite lattice</h2>
    {% set form = "-b" if lattice.definiteness == "negative_definite" else "b" %}
    {% if lattice.definiteness == "negative_definite" %}
    <p>The form is negative definite, so the invariants below are those of \(-b\) ({{ theory("definite-lattices", "sign", "sign convention") }}).</p>
    {% endif %}
    <table class="facts">
      <tbody>
        <tr><th scope="row">{{ theory("definite-lattices", "minimum", "Minimum") }} of \({{ form }}(x, x)\), \(x \neq 0\)</th><td>\({{ rational_tex(lattice.definite.minimum) }}\)</td></tr>
        <tr><th scope="row">{{ theory("definite-lattices", "minimum", "Kissing number") }}</th><td>{{ lattice.definite.kissing_number }}</td></tr>
        {% if lattice.definite.automorphism_group_order is not none %}
        <tr><th scope="row">Order of the {{ theory("definite-lattices", "isometry-group", "isometry group") }}</th><td>\({{ lattice.definite.automorphism_group_order }} = {{ factorisation_tex(lattice.definite.automorphism_group_order) }}\)</td></tr>
        {% endif %}
      </tbody>
    </table>
    {% if lattice.definite.theta_series is not none %}
    <h3>{{ theory("definite-lattices", "theta-series", "Theta series") }}</h3>
    \[ \sum_{x \in L} q^{ {{- form -}} (x, x)} = {{ theta_tex(lattice.definite.theta_series) }} \]
    {% endif %}
  </section>
  {% endif %}

  {% if lattice.indefinite %}
  <section aria-labelledby="indefinite">
    <h2 id="indefinite">Indefinite lattice</h2>
    <table class="facts">
      <tbody>
        <tr><th scope="row">{{ theory("indefinite-lattices", "isotropic", "Isotropic") }}</th><td>{{ yes_no(lattice.indefinite.isotropic) }}</td></tr>
      </tbody>
    </table>
  </section>
  {% endif %}

  {% if lattice.hyperbolic %}
  <section aria-labelledby="hyperbolic">
    <h2 id="hyperbolic">Hyperbolic lattice</h2>
    <table class="facts">
      <tbody>
        <tr><th scope="row">{{ theory("indefinite-lattices", "reflective", "Reflective") }}</th><td>{{ yes_no(lattice.hyperbolic.reflective) }} {{ declared() }}</td></tr>
      </tbody>
    </table>
  </section>
  {% endif %}

  <section aria-labelledby="roots">
    <h2 id="roots">{{ theory("roots", "roots", "Roots") }}</h2>
    {% set span = lattice.root_span %}
    {% set full_rank = lattice.root_span_rank == lattice.rank %}
    <table class="facts">
      <tbody>
        {% if lattice.is_root_lattice is none %}
        <tr><th scope="row">Root lattice: \(L = \mathbb{Z}\Phi(L)\)</th><td>{{ theory("records", "not-decided", "not decided") }}</td></tr>
        <tr><th scope="row">\(R(L) = \mathbb{Z}\Phi(L)\)</th><td>{{ theory("records", "not-decided", "not decided") }}</td></tr>
        {% else %}
        <tr><th scope="row">Root lattice: \(L = \mathbb{Z}\Phi(L)\)</th><td>{{ yes_no(lattice.is_root_lattice) }}</td></tr>
        {% if lattice.root_norms is not none %}
        <tr><th scope="row">\(L = \mathbb{Z}\Phi_S(L)\) for</th><td>\(S = {{ set_tex(lattice.root_norms) }}\)</td></tr>
        {% endif %}
        {% if lattice.definite %}
        <tr><th scope="row">Number of roots</th><td>{{ lattice.root_count }}</td></tr>
        {% endif %}
        <tr><th scope="row">\(R(L) = \mathbb{Z}\Phi(L)\)</th><td>
          {%- if span_summands -%}
          \(\cong\) {% for summand, name in span_summands %}<a class="tag" href="{{ root }}tag/{{ summand.tag }}.html">{{ summand.tag }}</a> \({{ name }}\){% if not loop.last %} \(\oplus\) {% endif %}{% endfor %}
          {%- elif span_name is none -%}
          {{ theory("records", "not-decided", "isometry class not decided") }}
          {%- elif span_name[1] in ("L", "0") -%}
          \({{ span_name[1] }}\)
          {%- else -%}
          \(\cong {{ span_name[1] }}\)
          {%- endif -%}
        </td></tr>
        <tr><th scope="row">Rank of \(R(L)\)</th><td>{{ lattice.root_span_rank }}</td></tr>
        <tr><th scope="row">\([L : R(L)]\)</th><td>{% if full_rank %}{{ lattice.root_span_index }}{% else %}infinite: the rank of \(R(L)\) is less than the rank of \(L\){% endif %}</td></tr>
        <tr><th scope="row">\(R(L)\) is primitive in \(L\)</th><td>
          {%- if lattice.root_span_is_primitive -%}
          yes
          {%- elif full_rank -%}
          no: \(L / R(L) \cong {{ group_tex(lattice.root_span_factors | reject("equalto", 1) | list) }}\)
          {%- else -%}
          no: \(M / R(L) \cong {{ group_tex(lattice.root_span_factors | reject("equalto", 1) | list) }}\) for \(M = L \cap (R(L) \otimes \mathbb{Q})\)
          {%- endif -%}
        </td></tr>
        {% if not lattice.definite %}
        <tr><th scope="row">Proof</th><td>
          {%- if not span.roots -%}
          The notes prove that \(L\) has no roots.
          {%- elif lattice.is_root_lattice -%}
          Each \(r_i\) in <a href="#generating-roots">roots that generate \(\mathbb{Z}\Phi(L)\)</a> is a root, and the \(r_i\) generate \(L\).
          {%- else -%}
          Each \(r_i\) in <a href="#generating-roots">roots that generate \(\mathbb{Z}\Phi(L)\)</a> is a root. The notes prove that each root of \(L\) is in \(\mathbb{Z}\{r_i\}\).
          {%- endif -%}
        </td></tr>
        {% endif %}
        {% endif %}
      </tbody>
    </table>
    {% if lattice.definite and lattice.definite.roots %}
    {% set several = lattice.definite.roots | length > 1 %}
    <h3>{{ theory("roots", "definite", "Components") }} of \(\Phi(L)\)</h3>
    <div class="table-scroll">
      <table class="member-table vector-table">
        <thead>
          <tr><th scope="col">Component</th><th scope="col">Type</th><th scope="col">Values of \(b(r, r)\)</th><th scope="col" class="numeric">Number of roots</th><th scope="col">\(\mathbb{Z}\Phi_c\)</th></tr>
        </thead>
        <tbody>
          {% for component in lattice.definite.roots %}
          <tr><td>\(\Phi_{ {{- loop.index -}} }\)</td><td>\({{ root_system_tex((component.type,)) }}\)</td><td>\({{ set_tex(component_norms(component)) }}\)</td><td class="numeric">{{ root_count(component.type) }}</td><td>\(\cong {{ component_lattice_tex(component) }}\)</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <h3>{{ theory("roots", "definite", "Simple roots") }}</h3>
    {% if several %}<p>\(\alpha^{(c)}_j\) is simple root \(j\) of the component \(\Phi_c\).</p>{% endif %}
    <div class="table-scroll">
      <table class="member-table vector-table">
        <thead>
          <tr><th scope="col">Simple root</th><th scope="col">Coordinates</th><th scope="col" class="numeric">\(b(r, r)\)</th></tr>
        </thead>
        <tbody>
          {% for component in lattice.definite.roots %}
          {% set c = loop.index %}
          {% set norms = component_norms(component) %}
          {% for simple_root in component.simple_roots %}
          <tr><td>\(\alpha{% if several %}^{({{ c }})}{% endif %}_{ {{- loop.index -}} }\)</td><td>\({{ combination_tex(simple_root) }}\)</td><td class="numeric">\({{ rational_tex(norms[loop.index0]) }}\)</td></tr>
          {% endfor %}
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if span and span.roots %}
    <h3 id="generating-roots">{{ theory("roots", "not-definite", "Roots that generate") }} \(\mathbb{Z}\Phi(L)\)</h3>
    {% if lattice.is_root_lattice %}<p>The \(r_i\) are a basis of \(L\).</p>{% endif %}
    <div class="table-scroll">
      <table class="member-table vector-table">
        <thead>
          <tr><th scope="col">Root</th><th scope="col">Coordinates</th><th scope="col" class="numeric">\(b(r, r)\)</th></tr>
        </thead>
        <tbody>
          {% for generating_root in span.roots %}
          <tr><td>\(r_{ {{- loop.index -}} }\)</td><td>\({{ combination_tex(generating_root) }}\)</td><td class="numeric">\({{ rational_tex(span.norms[loop.index0]) }}\)</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if span_images %}
    <h3>{{ theory("roots", "not-definite", "Embedding") }} \(M_1 \oplus M_2 \oplus \dots \to L\) with image \(\mathbb{Z}\Phi(L)\)</h3>
    <p>Image of each basis vector \(e_j\) of each summand \(M_i\).</p>
    <div class="table-scroll">
      <table class="member-table vector-table">
        <thead>
          <tr><th scope="col">Summand</th><th scope="col">Basis vector of the summand</th><th scope="col">Image in \(L\)</th></tr>
        </thead>
        <tbody>
          {% for summand, name, j, image in span_images %}
          <tr><td><a class="tag" href="{{ root }}tag/{{ summand.tag }}.html">{{ summand.tag }}</a> \({{ name }}\)</td><td>\(e_{ {{- j -}} }\)</td><td>\({{ combination_tex(image) }}\)</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </section>

  {% if prose | trim %}
  <section aria-labelledby="notes">
    <h2 id="notes">Notes</h2>
    <div class="prose">{{ prose }}</div>
  </section>
  {% endif %}

  {% if related %}
  <section aria-labelledby="related">
    <h2 id="related">Related lattices</h2>
    <ul class="related-list">
      {% for other, relation in related %}
      <li><a class="tag" href="{{ root }}tag/{{ other.tag }}.html">{{ other.tag }}</a> <span class="tag-name">\({{ other.latex }}\)</span> <span class="relation">{{ relation }}</span></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if morphism_files %}
  <section aria-labelledby="morphisms">
    <h2 id="morphisms">{{ theory("morphisms", "morphisms", "Morphisms") }}</h2>
    <ul class="related-list">
      {% for file in morphism_files %}
      {% set source, target = lattices[file.source], lattices[file.target] %}
      <li><a href="{{ root }}morphism/{{ file.source }}-{{ file.target }}.html">\({{ source.latex }} \to {{ target.latex }}\)</a> <span class="relation">{{ file.morphisms | length }} {{ "morphism" if file.morphisms | length == 1 else "morphisms" }}</span></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if lattice.references %}
  <section aria-labelledby="references">
    <h2 id="references">References</h2>
    <ol class="reference-list">
      {% for reference in lattice.references %}
      <li>{{ reference.citation }}{% if reference.url %} <a href="{{ reference.url }}">{{ reference.url }}</a>{% endif %}</li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  <nav class="pager" aria-label="Adjacent tags">
    {% if previous %}<a rel="prev" href="{{ root }}tag/{{ previous.tag }}.html"><span class="pager-label">Previous</span><span class="tag">{{ previous.tag }}</span> \({{ previous.latex }}\)</a>{% else %}<span></span>{% endif %}
    {% if following %}<a rel="next" href="{{ root }}tag/{{ following.tag }}.html"><span class="pager-label">Next</span><span class="tag">{{ following.tag }}</span> \({{ following.latex }}\)</a>{% endif %}
  </nav>
</article>
{% endblock %}
