{% extends "base.html.j2" %}
{% block title %}{{ lattice.name }} · {% endblock %}
{% macro yes_no(value) %}{{ "yes" if value else "no" }}{% endmacro %}
{% macro declared() %}<span class="declared" title="A person declared this value, and the notes give its source. The build did not compute it.">declared</span>{% endmacro %}
{% block main %}
<article>
  <header class="page-heading">
    <p class="kicker">Tag <span class="tag">{{ lattice.tag }}</span></p>
    <h1>\({{ lattice.latex }}\)</h1>
    <p class="names">{{ lattice.name }}{% for alias in lattice.aliases %}<span class="separator">·</span>{{ alias }}{% endfor %}</p>
    <ul class="chips" aria-label="Properties and families">
      <li><a href="{{ root }}database.html?definiteness={{ definiteness_label[lattice.definiteness] | urlencode }}">{{ definiteness_label[lattice.definiteness] }}</a></li>
      {% for property in properties(lattice) %}
      <li><a href="{{ root }}database.html?property={{ property | urlencode }}">{{ property }}</a></li>
      {% endfor %}
      {% for family in lattice.families %}
      <li class="family"><a href="{{ root }}database.html?family={{ family | urlencode }}" title="{{ families[family] }}">{{ family }}</a></li>
      {% endfor %}
    </ul>
  </header>

  <section aria-labelledby="invariants">
    <h2 id="invariants">Invariants</h2>
    <p>The build computes each value on this page from the Gram tensor and rejects a record that states another, except a value marked {{ declared() }}: a person declared it, and the notes give its source.</p>
    <table class="facts">
      <tbody>
        <tr><th scope="row">Rank</th><td>{{ lattice.rank }}</td></tr>
        <tr><th scope="row">Signature \((n_+, n_-)\)</th><td>({{ lattice.signature[0] }}, {{ lattice.signature[1] }})</td></tr>
        {% if lattice.nullity %}
        <tr><th scope="row">Rank of the radical</th><td>{{ lattice.nullity }}</td></tr>
        {% endif %}
        <tr><th scope="row">Determinant</th><td>\({{ rational_tex(lattice.determinant) }}\)</td></tr>
        <tr><th scope="row">Definiteness</th><td>{{ definiteness_label[lattice.definiteness] }}</td></tr>
        <tr><th scope="row">Integer values</th><td>{{ yes_no(lattice.integral is not none) }}</td></tr>
      </tbody>
    </table>
  </section>

  <section aria-labelledby="gram-tensor">
    <h2 id="gram-tensor">Gram tensor</h2>
    <p>The components \(b(e_i, e_j)\) of the Gram tensor \(b\) in the basis \({{ block_tex(range(1, lattice.rank + 1) | list) }}\) of the record.</p>
    {% if blocks | length > 1 %}
    <p>The record fixes an orthogonal decomposition of \(L\): \(L = {}\){% for block in blocks %}\(\mathbb{Z}\{ {{- block_tex(block) -}} \}\){% if not loop.last %} \(\oplus\) {% endif %}{% endfor %}, and \(b(e_i, e_j) = 0\) for \(e_i\), \(e_j\) in different summands.</p>
    {% endif %}
    <div class="table-scroll">
      <table class="components">
        <thead>
          <tr><td></td>{% for j in range(1, lattice.rank + 1) %}<th scope="col">\(e_{ {{- j -}} }\)</th>{% endfor %}</tr>
        </thead>
        <tbody>
          {% for components_row in lattice.gram_tensor %}
          <tr><th scope="row">\(e_{ {{- loop.index -}} }\)</th>{% for value in components_row %}<td{% if value == 0 %} class="zero"{% endif %}>{{ value }}</td>{% endfor %}</tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="copy-block">
      <pre id="components-text">{{ components_text }}</pre>
      <button type="button" data-copy="components-text">Copy</button>
    </div>
  </section>

  {% if lattice.integral %}
  <section aria-labelledby="integral">
    <h2 id="integral">Integral lattice</h2>
    <table class="facts">
      <tbody>
        <tr><th scope="row">Parity</th><td>{{ lattice.integral.parity }}</td></tr>
        {% if lattice.integral.discriminant_group is not none %}
        <tr><th scope="row">Discriminant group</th><td>\({{ group_tex(lattice.integral.discriminant_group) }}\)</td></tr>
        <tr><th scope="row">Unimodular</th><td>{{ yes_no(lattice.is_unimodular) }}</td></tr>
        <tr><th scope="row">Integral lattices \(M\) with \(L \subseteq M \subseteq L^*\)</th><td>{% if lattice.integral.overlattice_count is not none %}{{ lattice.integral.overlattice_count }}{% else %}not decided{% endif %}</td></tr>
        {% endif %}
        {% if lattice.integral.genus_symbol %}
        <tr><th scope="row">Genus symbol</th><td>\({{ genus_tex(lattice.integral.genus_symbol) }}\) {{ declared() }}</td></tr>
        {% endif %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {% if lattice.definite %}
  <section aria-labelledby="definite">
    <h2 id="definite">Definite lattice</h2>
    {% set form = "-b" if lattice.definiteness == "negative_definite" else "b" %}
    {% set norm = "-2" if lattice.definiteness == "negative_definite" else "2" %}
    {% if lattice.definiteness == "negative_definite" %}
    <p>The form is negative definite. The invariants below are those of \(-b\).</p>
    {% endif %}
    <table class="facts">
      <tbody>
        <tr><th scope="row">Minimum of \({{ form }}(x, x)\), \(x \neq 0\)</th><td>\({{ rational_tex(lattice.definite.minimum) }}\)</td></tr>
        <tr><th scope="row">Kissing number: the number of \(x\) at the minimum</th><td>{{ lattice.definite.kissing_number }}</td></tr>
        {% if lattice.definite.automorphism_group_order is not none %}
        <tr><th scope="row">Order of the isometry group</th><td>\({{ lattice.definite.automorphism_group_order }} = {{ factorisation_tex(lattice.definite.automorphism_group_order) }}\) {{ declared() }}</td></tr>
        {% endif %}
        {% if lattice.definite.root_system is not none %}
        <tr><th scope="row">Type of \(\Phi_{\{ {{- norm -}} \}}(L) = \{r \in L : b(r, r) = {{ norm }}\}\)</th><td>{% if lattice.definite.root_system %}\({{ root_system_tex(lattice.definite.root_system) }}\){% else %}\(\varnothing\){% endif %}</td></tr>
        {% endif %}
        {% if lattice.definite.root_system %}
        <tr><th scope="row">\(\mathbb{Z}\Phi_{\{ {{- norm -}} \}}(L)\)</th><td>rank {{ lattice.norm_two_span_rank }}{% if lattice.norm_two_span_index is not none %}, index {{ lattice.norm_two_span_index }} in \(L\){% endif %}</td></tr>
        {% endif %}
      </tbody>
    </table>
    {% if lattice.definite.theta_series is not none %}
    <h3>Theta series</h3>
    <p>The coefficient of \(q^k\) is the number of \(x \in L\) with \({{ form }}(x, x) = k\).</p>
    \[ \sum_{x \in L} q^{ {{- form -}} (x, x)} = {{ theta_tex(lattice.definite.theta_series) }} \]
    {% endif %}
  </section>
  {% endif %}

  {% if lattice.indefinite %}
  <section aria-labelledby="indefinite">
    <h2 id="indefinite">Indefinite lattice</h2>
    <table class="facts">
      <tbody>
        <tr><th scope="row">Isotropic: \(b(x, x) = 0\) for some \(x \neq 0\)</th><td>{{ yes_no(lattice.indefinite.isotropic) }}</td></tr>
      </tbody>
    </table>
  </section>
  {% endif %}

  {% if lattice.hyperbolic %}
  <section aria-labelledby="hyperbolic">
    <h2 id="hyperbolic">Hyperbolic lattice</h2>
    <table class="facts">
      <tbody>
        <tr><th scope="row">Reflective: the reflections generate a subgroup of finite index in the isometry group</th><td>{{ yes_no(lattice.hyperbolic.reflective) }} {{ declared() }}</td></tr>
      </tbody>
    </table>
  </section>
  {% endif %}

  <section aria-labelledby="roots">
    <h2 id="roots">Roots</h2>
    <p><a href="{{ root }}collection/root-lattices.html">Root lattices</a> defines the set \(\Phi(L)\) of the roots of \(L\), and the root sublattice \(R(L) = \mathbb{Z}\Phi(L)\) that the roots generate.</p>
    {% set span = lattice.root_span %}
    {% set full_rank = lattice.root_span_rank == lattice.rank %}
    <table class="facts">
      <tbody>
        {% if lattice.is_root_lattice is none %}
        <tr><th scope="row">Root lattice: \(L = \mathbb{Z}\Phi(L)\)</th><td>not decided</td></tr>
        <tr><th scope="row">\(R(L) = \mathbb{Z}\Phi(L)\)</th><td>not decided: the record does not state roots that generate it</td></tr>
        {% else %}
        <tr><th scope="row">Root lattice: \(L = \mathbb{Z}\Phi(L)\)</th><td>{{ yes_no(lattice.is_root_lattice) }}</td></tr>
        {% if lattice.root_norms is not none %}
        <tr><th scope="row">\(L = \mathbb{Z}\Phi_S(L)\) for</th><td>\(S = {{ set_tex(lattice.root_norms) }}\)</td></tr>
        {% endif %}
        {% if lattice.definite %}
        <tr><th scope="row">Number of roots</th><td>{{ 2 * (lattice.positive_roots | length) }}</td></tr>
        {% endif %}
        <tr><th scope="row">\(R(L) = \mathbb{Z}\Phi(L)\)</th><td>
          {%- if span_summands -%}
          \(\cong\) {% for summand, name in span_summands %}<a class="tag" href="{{ root }}tag/{{ summand.tag }}.html">{{ summand.tag }}</a> \({{ name }}\){% if not loop.last %} \(\oplus\) {% endif %}{% endfor %}
          {%- elif span_name is none -%}
          The record does not state a lattice that is isometric to it.
          {%- elif span_name[1] in ("L", "0") -%}
          \({{ span_name[1] }}\)
          {%- else -%}
          \(\cong {{ span_name[1] }}\)
          {%- endif -%}
        </td></tr>
        <tr><th scope="row">Rank of \(R(L)\)</th><td>{{ lattice.root_span_rank }}</td></tr>
        <tr><th scope="row">\([L : R(L)]\)</th><td>{% if full_rank %}{{ lattice.root_span_index }}{% else %}infinite: the rank of \(R(L)\) is less than the rank of \(L\){% endif %}</td></tr>
        <tr><th scope="row">\(R(L)\) is primitive in \(L\)</th><td>
          {%- if lattice.root_span_is_primitive -%}
          yes
          {%- elif full_rank -%}
          no: \(L / R(L) \cong {{ group_tex(lattice.root_span_factors | reject("equalto", 1) | list) }}\)
          {%- else -%}
          no: \(M / R(L) \cong {{ group_tex(lattice.root_span_factors | reject("equalto", 1) | list) }}\) for \(M = L \cap (R(L) \otimes \mathbb{Q})\)
          {%- endif -%}
        </td></tr>
        <tr><th scope="row">Proof</th><td>
          {%- if lattice.definite -%}
          The form is definite, so \(\Phi(L)\) is finite. The build lists \(\Phi(L)\).
          {%- elif not span.roots -%}
          The notes prove that \(L\) has no roots.
          {%- elif lattice.is_root_lattice -%}
          The build checks that each row of the table of roots below is a root. The rows generate \(L\).
          {%- else -%}
          The build checks that each row of the table of roots below is a root. The notes prove that each root of \(L\) is in the sublattice that the rows generate.
          {%- endif -%}
        </td></tr>
        {% endif %}
      </tbody>
    </table>
    {% if lattice.definite and lattice.definite.roots %}
    {% set several = lattice.definite.roots | length > 1 %}
    <h3>Components of \(\Phi(L)\)</h3>
    <p>\(\Phi(L)\) is the union of its irreducible components \(\Phi_c\), and two roots in different components are orthogonal. \(Q(\Phi_c)\) is the sublattice that \(\Phi_c\) generates, and \(\mathbb{Z}\Phi(L)\) is the orthogonal sum of the \(Q(\Phi_c)\).</p>
    <div class="table-scroll">
      <table class="member-table vector-table">
        <thead>
          <tr><th scope="col">Component</th><th scope="col">Type</th><th scope="col">Values of \(b(r, r)\)</th><th scope="col" class="numeric">Number of roots</th><th scope="col">\(Q(\Phi_c)\)</th></tr>
        </thead>
        <tbody>
          {% for component in lattice.definite.roots %}
          <tr><td>\(\Phi_{ {{- loop.index -}} }\)</td><td>\({{ root_system_tex((component.type,)) }}\)</td><td>\({{ set_tex(component_norms(lattice, component)) }}\)</td><td class="numeric">{{ root_count(component.type) }}</td><td>\(\cong {{ component_lattice_tex(component) }}\)</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <h3>Simple roots</h3>
    <p>
      Each row states one simple root in the basis \({{ block_tex(range(1, lattice.rank + 1) | list) }}\) of the record.
      {% if several %}\(\alpha^{(c)}_j\) is simple root \(j\) of the component \(\Phi_c\).{% endif %}
      The simple roots of a component are numbered as SageMath's <code>CartanMatrix</code> numbers them.
      The rows are a basis of \(\mathbb{Z}\Phi(L)\): they are the matrix of the embedding into \(L\) of the orthogonal sum of the \(Q(\Phi_c)\).
    </p>
    <div class="table-scroll">
      <table class="member-table vector-table">
        <thead>
          <tr><th scope="col">Simple root</th><th scope="col">In the basis of the record</th><th scope="col" class="numeric">\(b(r, r)\)</th></tr>
        </thead>
        <tbody>
          {% for component in lattice.definite.roots %}
          {% set c = loop.index %}
          {% set norms = component_norms(lattice, component) %}
          {% for simple_root in component.simple_roots %}
          <tr><td>\(\alpha{% if several %}^{({{ c }})}{% endif %}_{ {{- loop.index -}} }\)</td><td>\({{ combination_tex(simple_root) }}\)</td><td class="numeric">\({{ rational_tex(norms[loop.index0]) }}\)</td></tr>
          {% endfor %}
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if span and span.roots %}
    <h3>Roots that generate \(\mathbb{Z}\Phi(L)\)</h3>
    <p>Each row states one root in the basis \({{ block_tex(range(1, lattice.rank + 1) | list) }}\) of the record.{% if lattice.is_root_lattice %} The rows are a basis of \(L\).{% endif %}</p>
    <div class="table-scroll">
      <table class="member-table vector-table">
        <thead>
          <tr><th scope="col">Root</th><th scope="col">In the basis of the record</th><th scope="col" class="numeric">\(b(r, r)\)</th></tr>
        </thead>
        <tbody>
          {% for generating_root in span.roots %}
          <tr><td>\(r_{ {{- loop.index -}} }\)</td><td>\({{ combination_tex(generating_root) }}\)</td><td class="numeric">\({{ rational_tex(lattice.spanning_roots[generating_root]) }}\)</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if span_images %}
    <h3>Embedding of the orthogonal summands</h3>
    <p>The isometric embedding of the orthogonal sum of the summands into \(L\) has the image \(\mathbb{Z}\Phi(L)\). Each row states the image of one basis vector of the record of a summand.</p>
    <div class="table-scroll">
      <table class="member-table vector-table">
        <thead>
          <tr><th scope="col">Summand</th><th scope="col">Basis vector of the summand</th><th scope="col">Image in \(L\)</th></tr>
        </thead>
        <tbody>
          {% for summand, name, j, image in span_images %}
          <tr><td><a class="tag" href="{{ root }}tag/{{ summand.tag }}.html">{{ summand.tag }}</a> \({{ name }}\)</td><td>\(e_{ {{- j -}} }\)</td><td>\({{ combination_tex(image) }}\)</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </section>

  {% if prose | trim %}
  <section aria-labelledby="notes">
    <h2 id="notes">Notes</h2>
    <div class="prose">{{ prose }}</div>
  </section>
  {% endif %}

  {% if related %}
  <section aria-labelledby="related">
    <h2 id="related">Related lattices</h2>
    <ul class="related-list">
      {% for other, relation in related %}
      <li><a class="tag" href="{{ root }}tag/{{ other.tag }}.html">{{ other.tag }}</a> <span class="tag-name">\({{ other.latex }}\)</span> <span class="relation">{{ relation }}</span></li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if lattice.references %}
  <section aria-labelledby="references">
    <h2 id="references">References</h2>
    <ol class="reference-list">
      {% for reference in lattice.references %}
      <li>{{ reference.citation }}{% if reference.url %} <a href="{{ reference.url }}">{{ reference.url }}</a>{% endif %}</li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  <section aria-labelledby="provenance">
    <h2 id="provenance">Provenance</h2>
    <p>{{ lattice.provenance.source }}</p>
    <table class="facts">
      <tbody>
        {% if lattice.provenance.url %}
        <tr><th scope="row">Source record</th><td><a href="{{ lattice.provenance.url }}">{{ lattice.provenance.url }}</a></td></tr>
        {% endif %}
        {% if lattice.provenance.computed_with %}
        <tr><th scope="row">Computed with</th><td>{{ lattice.provenance.computed_with }}</td></tr>
        {% endif %}
        <tr><th scope="row">Record</th><td><code>lattices/{{ lattice.tag }}.md</code></td></tr>
      </tbody>
    </table>
  </section>

  <nav class="pager" aria-label="Adjacent tags">
    {% if previous %}<a rel="prev" href="{{ root }}tag/{{ previous.tag }}.html"><span class="pager-label">Previous</span><span class="tag">{{ previous.tag }}</span> \({{ previous.latex }}\)</a>{% else %}<span></span>{% endif %}
    {% if following %}<a rel="next" href="{{ root }}tag/{{ following.tag }}.html"><span class="pager-label">Next</span><span class="tag">{{ following.tag }}</span> \({{ following.latex }}\)</a>{% endif %}
  </nav>
</article>
{% endblock %}
