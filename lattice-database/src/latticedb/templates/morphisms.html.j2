{% extends "base.html.j2" %}
{% from "macros.html.j2" import theory with context %}
{% block title %}Morphisms · {% endblock %}
{% block main %}
<header class="page-heading">
  <h1>Morphisms</h1>
  <p class="lede">
    {{ theory("morphisms", "morphisms", "Morphisms") }} between lattices of the catalogue, as {{ theory("morphisms", "matrices", "matrices") }} in the chosen bases.
  </p>
</header>
<section aria-labelledby="pairs">
  <h2 id="pairs">By source and target</h2>
  <ul class="related-list">
    {% for file in files %}
    <li>
      <a class="tag" href="{{ root }}tag/{{ file.source }}.html">{{ file.source }}</a> \(\to\) <a class="tag" href="{{ root }}tag/{{ file.target }}.html">{{ file.target }}</a>
      <a href="{{ root }}morphism/{{ file.source }}-{{ file.target }}.html">\({{ lattices[file.source].latex }} \to {{ lattices[file.target].latex }}\)</a>
      <span class="relation">{{ file.morphisms | length }} {{ "morphism" if file.morphisms | length == 1 else "morphisms" }}</span>
    </li>
    {% endfor %}
  </ul>
</section>
{% endblock %}
