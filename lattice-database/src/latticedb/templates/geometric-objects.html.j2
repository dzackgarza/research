{% extends "base.html.j2" %}
{% block title %}Geometric objects · {% endblock %}
{% block main %}
<header class="page-heading">
  <h1>Geometric objects</h1>
  <p class="lede">Varieties, analytic spaces and symmetric spaces, with their defining structures and cited invariants.</p>
</header>
<h2>Parameterized families</h2>
<ul class="collection-list">
  {% for entry in geometric_families %}
  <li><a href="{{ root }}geometric-families/{{ entry.family.slug }}.html">{{ entry.family.name }}</a></li>
  {% endfor %}
</ul>
<h2>Spaces and instances</h2>
<ul class="collection-list">
  {% for entry in geometric %}
  <li><a href="{{ root }}geometric-objects/{{ entry.geometric.slug }}.html">{{ entry.geometric.name }}</a> — {{ entry.geometric.kind.replace("_", " ") }}</li>
  {% endfor %}
</ul>
{% endblock %}
