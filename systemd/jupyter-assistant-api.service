[Unit]
Description=Jupyter Assistant API (FastAPI adapter for GPT Actions)
After=jupyter-sagemath.service
Wants=jupyter-sagemath.service

[Service]
Type=simple
WorkingDirectory=/home/dzack/gitclones/jupyter-assistant-api
ExecStart=/bin/direnv exec /home/dzack/research /usr/bin/env PATH=/home/dzack/gitclones/sage-dev-allopts/.venv/bin:/home/dzack/.local/bin:/usr/local/bin:/usr/bin:/bin /home/dzack/gitclones/sage-dev-allopts/.venv/bin/jupyter-assistant-api
Restart=on-failure
RestartSec=5
Environment=HOME=/home/dzack

[Install]
WantedBy=default.target
