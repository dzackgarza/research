[Unit]
Description=JupyterLab dynamic dashboard
After=default.target
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/dzack/research/computations/notebooks
ExecStartPre=/home/dzack/.config/systemd/user/check-port-8888.py
ExecStart=/bin/direnv exec /home/dzack /home/dzack/gitclones/sage-dev-allopts/sage --notebook=jupyterlab --IdentityProvider.password_required=False --IdentityProvider.hashed_password='' --IdentityProvider.token='' --ServerApp.disable_check_xsrf=True --ip=0.0.0.0 --port=8888 --ServerApp.root_dir=/home/dzack/research/computations/notebooks --no-browser
Restart=on-failure
RestartSec=5
Environment=HOME=/home/dzack
Environment=JUPYTER_PORT=8888

[Install]
WantedBy=default.target
