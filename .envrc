source "$HOME/.envrc"

# Sage QC (~/ai-review-ci/justfiles/sage.just) requires the Sage driver path.
# The checkout driver owns the full Sage CLI (`--preparse`, `-python`, etc.);
# `.venv/bin/sage` is the narrower installed console entry point.  The driver
# runs the first `python3` on PATH, so the checkout's venv goes on PATH too;
# without it the driver reaches a Python that has no `sage` module.
export SAGE_BIN="${SAGE_BIN:-/home/dzack/gitclones/sage-dev-allopts/sage}"
_sage_bin_dir="${SAGE_BIN%/*}"
for _sage_path_dir in "$_sage_bin_dir/.venv/bin" "$_sage_bin_dir"; do
  case ":${PATH:-}:" in
    *":$_sage_path_dir:"*) ;;
    *) export PATH="$_sage_path_dir${PATH:+:$PATH}" ;;
  esac
done
unset _sage_bin_dir _sage_path_dir

# Released sage-categories engine adapters use this repository's PackageManager installation.
export SAGE_CATEGORIES_GAP_PACKAGE_DIR="$PWD/.gap/pkg"

export RESEARCH_EXPERIMENTS="$PWD/computations/experiments"
case ":${PYTHONPATH:-}:" in
  *":$RESEARCH_EXPERIMENTS:"*) ;;
  *) export PYTHONPATH="$RESEARCH_EXPERIMENTS${PYTHONPATH:+:$PYTHONPATH}" ;;
esac

# Archived spike trees under computations/archives/, if any remain.
export RESEARCH_ARCHIVES="$PWD/computations/archives"
case ":${PYTHONPATH:-}:" in
  *":$RESEARCH_ARCHIVES:"*) ;;
  *) export PYTHONPATH="$RESEARCH_ARCHIVES${PYTHONPATH:+:$PYTHONPATH}" ;;
esac

export RESEARCH_SOURCE="$PWD/src"
case ":${PYTHONPATH:-}:" in
  *":$RESEARCH_SOURCE:"*) ;;
  *) export PYTHONPATH="$RESEARCH_SOURCE${PYTHONPATH:+:$PYTHONPATH}" ;;
esac

# LaTeX round-trip tests parse with the real MathJax, not a stand-in: the
# fork vendored here is the same parser the notebook renders with.
export MATHJAX_FULL_ROOT="$PWD/subrepos/mathjax-extension-fork/node_modules/mathjax-full"
