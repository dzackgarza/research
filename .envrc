source "$HOME/.envrc"

# Sage QC (~/ai-review-ci/justfiles/sage.just) requires the Sage executable path.
export SAGE_BIN="${SAGE_BIN:-/home/dzack/gitclones/sage-dev-allopts/.venv/bin/sage}"

export RESEARCH_EXPERIMENTS="$PWD/computations/experiments"
case ":${PYTHONPATH:-}:" in
  *":$RESEARCH_EXPERIMENTS:"*) ;;
  *) export PYTHONPATH="$RESEARCH_EXPERIMENTS${PYTHONPATH:+:$PYTHONPATH}" ;;
esac

# The category spike is archived reference code (QC-shielded under archives/),
# but the preamble still imports its lexicon at runtime.
export RESEARCH_ARCHIVES="$PWD/computations/archives"
case ":${PYTHONPATH:-}:" in
  *":$RESEARCH_ARCHIVES:"*) ;;
  *) export PYTHONPATH="$RESEARCH_ARCHIVES${PYTHONPATH:+:$PYTHONPATH}" ;;
esac

export RESEARCH_SOURCE="$PWD/src"
case ":${PYTHONPATH:-}:" in
  *":$RESEARCH_SOURCE:"*) ;;
  *) export PYTHONPATH="$RESEARCH_SOURCE${PYTHONPATH:+:$PYTHONPATH}" ;;
esac

# The preamble's LaTeX round-trip tests parse with the real MathJax, not a
# stand-in: the fork vendored here is the same parser the notebook renders
# with, so a test that passes proves the notebook renders.
export MATHJAX_FULL_ROOT="$PWD/mathjax-extension-fork/node_modules/mathjax-full"
