#!/bin/sh
set -eu
hooks=$(git config --global --path --get core.hooksPath || true)
if [ -z "$hooks" ]; then
    printf '%s\n' \
        'Push rejected: the global git hooks are not installed: core.hooksPath is not set globally.' \
        'Install them: in an ai-review-ci checkout, run `just install-global-git-hooks` (README, "Global Git hooks").' >&2
    exit 1
fi
exec "$hooks/pre-push" "$@"
